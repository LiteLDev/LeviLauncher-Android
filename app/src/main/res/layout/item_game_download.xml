<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/game_release_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@color/divider" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="36dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_minecraft_cube"
                android:scaleType="fitCenter" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Levi.Body"
                        android:id="@+id/game_release_name"
                        android:layout_weight="1"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/game_release_state"
                        style="@style/GameDownloadChip"
                        android:text="@string/game_download_state_downloaded"
                        android:layout_marginStart="6dp"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/game_release_latest"
                        style="@style/GameDownloadChip"
                        android:text="@string/game_download_latest"
                        android:layout_marginStart="6dp"
                        android:visibility="gone" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/game_release_type"
                        style="@style/GameDownloadChip"
                        android:text="@string/game_download_type_release" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Levi.Body"
                        android:id="@+id/game_release_meta"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/game_release_action"
                style="@style/Widget.Levi.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="80dp"
                android:minHeight="36dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/game_download_download"
                android:textSize="12sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/game_release_menu"
                style="@style/Widget.Levi.Button.Icon"
                android:layout_width="32dp"
                android:layout_height="36dp"
                android:minWidth="32dp"
                android:minHeight="36dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/game_download_version_actions"
                app:icon="@drawable/ic_more_vert"
                app:iconSize="18dp"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/game_release_progress_row"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/game_release_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="100"
                android:progressDrawable="@drawable/game_download_progress"
                android:progressTint="@color/primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Levi.Body"
                android:id="@+id/game_release_progress_text"
                android:layout_marginTop="4dp"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Levi.Body"
            android:id="@+id/game_release_error"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:textColor="@color/error"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
