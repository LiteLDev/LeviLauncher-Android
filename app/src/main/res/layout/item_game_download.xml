<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the version table (版本 / 类型 / 状态 / 操作), shared by activity_game_download.xml
     (two-pane: Version + Actions, chips in the Version cell) and activity_game_download_stacked.xml
     (all four columns); GameDownloadActivity adapts it. Download progress and errors show inline under the row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/game_release_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal">

            <!-- Version -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_ui_icon_chip">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:padding="5dp"
                        android:src="@drawable/ic_minecraft_cube" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- wrap_content + weight: the tag follows the name, the name ellipsizes when long -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/game_release_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.Levi.Body"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/game_release_latest"
                            style="@style/GameDownloadChip"
                            android:layout_marginStart="6dp"
                            android:text="@string/game_download_latest" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/game_release_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Levi.Caption" />

                    <!-- Two-pane only: the type and state chips, moved here from their columns -->
                    <LinearLayout
                        android:id="@+id/game_release_chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Type (stacked layout only; two-pane moves the chip into game_release_chips) -->
            <FrameLayout
                android:id="@+id/game_release_type_col"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4">

                <TextView
                    android:id="@+id/game_release_type"
                    style="@style/GameDownloadChip"
                    android:layout_gravity="start|center_vertical" />
            </FrameLayout>

            <!-- Status (stacked layout only, like Type) -->
            <FrameLayout
                android:id="@+id/game_release_state_col"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4">

                <TextView
                    android:id="@+id/game_release_state"
                    style="@style/GameDownloadChip"
                    android:layout_gravity="start|center_vertical" />
            </FrameLayout>

            <!-- Actions: 200dp in the stacked layout (matches its header), wrap_content in two-pane -->
            <LinearLayout
                android:id="@+id/game_release_actions"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/game_release_delete"
                    style="@style/Widget.Levi.Button.Icon"
                    android:contentDescription="@string/game_download_delete_title"
                    app:backgroundTint="@color/ui_danger_soft"
                    app:icon="@drawable/ic_ui_delete"
                    app:iconTint="@color/ui_danger" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/game_release_secondary"
                    style="@style/Widget.Levi.Button.Icon"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/game_download_redownload"
                    app:icon="@drawable/ic_ui_refresh" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/game_release_action"
                    style="@style/Widget.Levi.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="92dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/game_release_progress_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="46dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/game_release_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:max="100"
                android:progressDrawable="@drawable/game_download_progress" />

            <TextView
                android:id="@+id/game_release_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textAppearance="@style/TextAppearance.Levi.Caption" />
        </LinearLayout>

        <TextView
            android:id="@+id/game_release_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="46dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:textAppearance="@style/TextAppearance.Levi.Caption"
            android:textColor="@color/ui_danger"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
