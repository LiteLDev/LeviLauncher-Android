<?xml version="1.0" encoding="utf-8"?>
<!-- Default shell, as LeviLauncher for Windows "sidebar" layout: a 56dp top bar (logo, back/forward,
     breadcrumbs, news, account) over a 56dp icon rail, and the page area with a concave corner.
     BaseActivity puts the page into @id/shell_content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shell_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_chrome"
    android:orientation="vertical"
    android:tag="levi_keep_background">

    <LinearLayout
        android:id="@+id/nav_bar_root"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="12dp"
        android:tag="levi_keep_background">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/nav_logo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_leaf_logo" />
        </FrameLayout>

        <ImageView
            android:id="@+id/nav_back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_shell_icon_button"
            android:contentDescription="@string/nav_back"
            android:padding="10dp"
            android:src="@drawable/ic_ui_arrow_back"
            android:tooltipText="@string/nav_back"
            app:tint="@color/ui_muted" />

        <ImageView
            android:id="@+id/nav_forward_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_shell_icon_button"
            android:contentDescription="@string/nav_forward"
            android:padding="10dp"
            android:src="@drawable/ic_ui_arrow_forward"
            android:tooltipText="@string/nav_forward"
            app:tint="@color/ui_muted" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="10dp"
            android:background="@color/ui_border" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/nav_breadcrumbs"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/nav_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/misans"
                    android:text="@string/app_name"
                    android:textColor="@color/accent_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>

        <include layout="@layout/shell_account_cluster" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/nav_rail"
            android:layout_width="64dp"
            android:layout_height="match_parent">

            <!-- Scrolls only when an item had to move below the front camera and space ran out. -->
            <ScrollView
                android:id="@+id/nav_rail_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

            <LinearLayout
                android:id="@+id/nav_rail_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/nav_tab_launch"
                    style="@style/Widget.Levi.RailItem"
                    android:contentDescription="@string/nav_launch"
                    android:drawableTop="@drawable/ic_nav_launch"
                    android:tooltipText="@string/nav_launch" />

                <TextView
                    android:id="@+id/nav_tab_download"
                    style="@style/Widget.Levi.RailItem"
                    android:contentDescription="@string/nav_download"
                    android:drawableTop="@drawable/ic_nav_download"
                    android:tooltipText="@string/nav_download" />

                <TextView
                    android:id="@+id/nav_tab_instances"
                    style="@style/Widget.Levi.RailItem"
                    android:contentDescription="@string/nav_instances"
                    android:drawableTop="@drawable/ic_nav_instances"
                    android:tooltipText="@string/nav_instances" />

                <TextView
                    android:id="@+id/nav_tab_about"
                    style="@style/Widget.Levi.RailItem"
                    android:contentDescription="@string/nav_about"
                    android:drawableTop="@drawable/ic_nav_about"
                    android:tooltipText="@string/nav_about" />

                <TextView
                    android:id="@+id/nav_tab_settings"
                    style="@style/Widget.Levi.RailItem"
                    android:contentDescription="@string/nav_settings"
                    android:drawableTop="@drawable/ic_nav_settings"
                    android:tooltipText="@string/nav_settings" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/nav_theme_toggle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_shell_icon_button"
                    android:contentDescription="@string/nav_toggle_theme"
                    android:padding="14dp"
                    android:src="@drawable/ic_sun"
                    android:tooltipText="@string/nav_toggle_theme"
                    app:tint="@color/ui_muted" />
            </LinearLayout>
            </ScrollView>

            <View
                android:id="@+id/nav_rail_indicator"
                android:layout_width="4dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_shell_rail_indicator"
                android:visibility="invisible" />
        </FrameLayout>

        <org.levimc.launcher.ui.widget.ShellContentFrame
            android:id="@+id/shell_content"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_shell_content"
            android:tag="levi_keep_background" />
    </LinearLayout>
</LinearLayout>
