<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:focusable="true" android:focusableInTouchMode="true">
    <LinearLayout android:id="@+id/instance_settings_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="40dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="12dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Body" android:id="@+id/instance_settings_title" android:textSize="18sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:text="@string/instance_settings_title" />
            <TextView android:id="@+id/instance_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Caption" android:textSize="11sp" android:singleLine="true" android:ellipsize="end" android:layout_marginTop="2dp" android:includeFontPadding="false" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Body" android:id="@+id/instance_version_tag" style="@style/Widget.Levi.Tag" android:textSize="10sp" android:maxWidth="160dp" android:singleLine="true" android:ellipsize="end" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" />
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="8dp" android:fillViewport="true" android:scrollbars="none" android:overScrollMode="never">
        <org.levimc.launcher.ui.widget.SegmentedControl android:id="@+id/instance_tabs" android:layout_width="wrap_content" android:layout_height="32dp" />
    </HorizontalScrollView>
    <ScrollView android:id="@+id/instance_settings_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:fillViewport="true" android:scrollbars="none" android:overScrollMode="ifContentScrolls">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:id="@+id/section_general" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="visible">
                <com.google.android.material.card.MaterialCardView style="@style/Widget.Levi.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/instance_new_name" android:textAppearance="@style/TextAppearance.Levi.SectionTitle" android:textSize="13sp" />
                        <EditText android:id="@+id/edit_instance_name" style="@style/Widget.Levi.Input" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="8dp" android:background="@drawable/v161_instances_bg_search" android:paddingStart="14dp" android:paddingEnd="14dp" android:importantForAutofill="no" android:inputType="text" android:textSize="13sp" android:minHeight="36dp" android:imeOptions="actionDone|flagNoExtractUi" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/instance_rename_hint" android:textAppearance="@style/TextAppearance.Levi.Caption" android:textSize="11sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/instance_custom_icon" android:textAppearance="@style/TextAppearance.Levi.SectionTitle" android:textSize="13sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <FrameLayout android:id="@+id/btn_choose_shortcut_icon" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/instances_bg_icon_slot" android:clickable="true" android:contentDescription="@string/instance_shortcut_choose_icon" android:focusable="true" android:foreground="?android:attr/selectableItemBackground">
                                <ImageView android:id="@+id/instance_icon_placeholder" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_ui_add" app:tint="@color/text_secondary" />
                                <ImageView android:id="@+id/shortcut_icon_preview" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/instance_shortcut_icon" android:scaleType="centerCrop" android:visibility="gone" />
                            </FrameLayout>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_reset_shortcut_icon" style="@style/Widget.Levi.Button.Danger" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="12dp" android:minHeight="36dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="@string/instance_clear_icon" android:textSize="12sp" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/instances_ui_icon_hint" android:textAppearance="@style/TextAppearance.Levi.Caption" android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView style="@style/Widget.Levi.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/instance_shortcut_title" android:textAppearance="@style/TextAppearance.Levi.SectionTitle" android:textSize="13sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/instance_shortcut_desc" android:textAppearance="@style/TextAppearance.Levi.Caption" android:textSize="11sp" />
                        <LinearLayout android:id="@+id/shortcut_config" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/instance_shortcut_name" android:textAppearance="@style/TextAppearance.Levi.FieldLabel" android:textSize="13sp" android:textStyle="bold" />
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical">
                                <EditText android:id="@+id/edit_shortcut_name" style="@style/Widget.Levi.Input" android:layout_width="match_parent" android:layout_height="36dp" android:background="@drawable/v161_instances_bg_search" android:paddingStart="14dp" android:paddingEnd="14dp" android:importantForAutofill="no" android:inputType="text" android:textSize="13sp" android:minHeight="36dp" android:imeOptions="actionDone|flagNoExtractUi" />
                                <com.google.android.material.button.MaterialButton android:id="@+id/btn_add_instance_shortcut" style="@style/Widget.Levi.Button.Primary" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginTop="8dp" android:paddingStart="20dp" android:paddingEnd="20dp" android:text="@string/instance_shortcut_add_button" app:icon="@drawable/ic_ui_add" android:minHeight="36dp" android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/section_launch_options" android:visibility="gone">
                <com.google.android.material.card.MaterialCardView style="@style/Widget.Levi.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="56dp" android:paddingTop="8dp" android:paddingBottom="8dp">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="16dp" android:orientation="vertical">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Body" android:text="@string/instance_mod_menu_title" android:textSize="13sp" android:textStyle="bold" android:includeFontPadding="false" />
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Caption" android:text="@string/instance_mod_menu_description" android:textSize="11sp" android:layout_marginTop="3dp" android:includeFontPadding="false" />
                            </LinearLayout>
                            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch_instance_mod_menu" style="@style/Widget.Levi.Switch" android:layout_width="52dp" android:layout_height="36dp" android:minHeight="0dp" android:contentDescription="@string/instance_mod_menu_title" android:checked="true" />
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="56dp" android:paddingTop="8dp" android:paddingBottom="8dp">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="16dp" android:orientation="vertical">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Body" android:text="@string/version_isolation" android:textSize="13sp" android:textStyle="bold" android:includeFontPadding="false" />
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Caption" android:text="@string/instance_isolation_desc" android:textSize="11sp" android:layout_marginTop="3dp" android:includeFontPadding="false" />
                            </LinearLayout>
                            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch_version_isolation" style="@style/Widget.Levi.Switch" android:layout_width="52dp" android:layout_height="36dp" android:minHeight="0dp" android:contentDescription="@string/version_isolation" />
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="56dp" android:paddingTop="8dp" android:paddingBottom="8dp">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="16dp" android:orientation="vertical">
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Body" android:text="@string/launch_vertically" android:textSize="13sp" android:textStyle="bold" android:includeFontPadding="false" />
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Caption" android:text="@string/launch_vertically_desc" android:textSize="11sp" android:layout_marginTop="3dp" android:includeFontPadding="false" />
                            </LinearLayout>
                            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch_launch_vertically" style="@style/Widget.Levi.Switch" android:layout_width="52dp" android:layout_height="36dp" android:minHeight="0dp" android:contentDescription="@string/launch_vertically" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <LinearLayout android:id="@+id/section_loader" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <include layout="@layout/view_pkg_loader_card" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/section_management" android:visibility="gone">
                <com.google.android.material.card.MaterialCardView style="@style/Widget.Levi.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="48dp">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="16dp" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Body" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/text_primary" android:text="@string/instance_backup_title" />
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Caption" android:text="@string/instance_backup_desc" android:textSize="11sp" android:layout_marginTop="3dp" />
                            </LinearLayout>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_backup_instance" style="@style/Widget.Levi.Button.Secondary" android:layout_width="wrap_content" android:layout_height="36dp" android:minHeight="36dp" android:text="@string/instance_backup_button" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView style="@style/Widget.Levi.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="48dp">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="16dp" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Body" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/ui_danger" android:text="@string/delete" />
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Caption" android:text="@string/instance_delete_desc" android:textSize="11sp" android:layout_marginTop="3dp" />
                            </LinearLayout>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_delete_instance" style="@style/Widget.Levi.Button.Danger" android:layout_width="wrap_content" android:layout_height="36dp" android:minHeight="36dp" android:text="@string/delete" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" />
                        </LinearLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Caption" android:text="@string/instance_delete_warning" android:textSize="11sp" android:textColor="@color/ui_danger" android:layout_marginTop="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
