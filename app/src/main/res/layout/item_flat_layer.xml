<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginVertical="3dp" android:background="@drawable/bg_content_item" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="8dp">
    <ImageView android:id="@+id/drag_handle" android:layout_width="28dp" android:layout_height="match_parent" android:contentDescription="@string/reorder_layer" android:padding="6dp" android:src="@drawable/ic_drag_handle" android:tint="@color/text_secondary" />
    <TextView android:id="@+id/layer_number" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="2dp" android:background="@drawable/bg_circle" android:fontFamily="@font/misans" android:gravity="center" android:text="1" android:textColor="@color/on_primary" android:textSize="11sp" android:textStyle="bold" />
    <EditText android:id="@+id/block_edit" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_ui_input" android:fontFamily="@font/misans" android:hint="@string/block_id_hint" android:inputType="text" android:maxLines="1" android:paddingHorizontal="10dp" android:textColor="@color/on_surface" android:textColorHint="@color/text_secondary" android:textSize="13sp" android:imeOptions="actionDone|flagNoExtractUi" android:importantForAutofill="no" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:fontFamily="@font/misans" android:text="×" android:textColor="@color/text_secondary" android:textSize="14sp" />
    <EditText android:id="@+id/count_edit" android:layout_width="48dp" android:layout_height="36dp" android:layout_marginStart="6dp" android:background="@drawable/bg_ui_input" android:fontFamily="@font/misans" android:gravity="center" android:hint="1" android:inputType="number" android:maxLength="3" android:paddingHorizontal="6dp" android:text="1" android:textColor="@color/on_surface" android:textColorHint="@color/text_secondary" android:textSize="13sp" android:imeOptions="actionDone|flagNoExtractUi" android:importantForAutofill="no" />
    <ImageButton android:id="@+id/delete_layer_button" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="6dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/delete_layer" android:padding="8dp" android:src="@drawable/ic_delete" android:tint="@color/error" />
</LinearLayout>
