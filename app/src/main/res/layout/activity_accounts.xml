<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/accounts_page_title" android:textAppearance="@style/TextAppearance.Levi.SectionTitle" android:textSize="18sp" android:accessibilityHeading="true" android:includeFontPadding="false" />
            <TextView android:id="@+id/accounts_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textAppearance="@style/TextAppearance.Levi.Caption" android:textSize="11sp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/bottom_add_button" style="@style/Widget.Levi.Button.Primary" android:layout_width="wrap_content" android:layout_height="40dp" android:text="@string/ms_add_account" android:textSize="12sp" app:icon="@drawable/ic_ui_add" />
    </LinearLayout>
    <LinearLayout android:id="@+id/accounts_operation" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="8dp" android:visibility="gone">
        <ProgressBar android:layout_width="18dp" android:layout_height="18dp" android:indeterminateTint="@color/primary" />
        <TextView android:id="@+id/accounts_operation_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:textAppearance="@style/TextAppearance.Levi.Caption" android:textSize="12sp" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/accounts_recycler_view" android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never" android:clipToPadding="false" android:paddingBottom="4dp" android:scrollbars="vertical" />
        <ScrollView android:id="@+id/empty_state_container" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:overScrollMode="never" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="20dp">
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_ui_person" app:tint="@color/text_secondary" android:importantForAccessibility="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/accounts_empty_title" android:textAppearance="@style/TextAppearance.Levi.SectionTitle" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/accounts_empty_description" android:textAppearance="@style/TextAppearance.Levi.Caption" android:gravity="center" android:maxWidth="400dp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
