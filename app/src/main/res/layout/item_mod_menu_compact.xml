<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:layout_margin="3dp" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="10dp" android:clickable="true" android:focusable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="42dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/mod_card_icon" android:layout_width="20dp" android:layout_height="24dp" android:layout_marginEnd="8dp" android:importantForAccessibility="no" />
        <TextView android:id="@+id/mod_card_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingEnd="4dp" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
        <ImageButton android:id="@+id/mod_card_favorite" android:layout_width="36dp" android:layout_height="42dp" android:padding="8dp" android:src="@drawable/ic_modmenu_star" android:contentDescription="@string/mod_menu_favorite" />
        <ImageButton android:id="@+id/mod_card_config" android:layout_width="36dp" android:layout_height="42dp" android:padding="8dp" android:src="@drawable/ic_modmenu_settings" android:contentDescription="@string/settings" />
        <org.levimc.launcher.core.mods.inbuilt.overlay.ModMenuToggle android:id="@+id/mod_card_toggle" android:layout_width="46dp" android:layout_height="42dp" android:saveEnabled="false" />
    </LinearLayout>
    <TextView android:id="@+id/mod_card_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textSize="10.5sp" android:lineSpacingExtra="2dp" android:includeFontPadding="false" />
    <TextView android:id="@+id/mod_card_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:visibility="gone" />
    <TextView android:id="@+id/mod_card_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
</LinearLayout>
