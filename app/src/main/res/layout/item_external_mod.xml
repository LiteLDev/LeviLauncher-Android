<?xml version="1.0" encoding="utf-8"?>
<!-- A catalog card in the 3-column grid, laid out like v1.6.1: icon chip with name / author · version
     beside it, description, tags, and a full-width install button at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/external_mod_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/v161r2_mods_external_card"
    android:orientation="vertical">

    <!-- v1.6.1 cards are separate, so the divider takes no space. -->
    <View
        android:id="@+id/external_mod_divider"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="198dp"
        android:orientation="vertical"
        android:padding="11dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/external_mod_icon_chip"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_ui_icon_chip">

                <ImageView
                    android:id="@+id/external_mod_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="3dp"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/external_mod_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Levi.SectionTitle"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/external_mod_author"
                        android:layout_width="wrap_content"
                        android:maxWidth="160dp"
                        android:layout_height="wrap_content"
                            android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Levi.Caption"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/external_mod_version"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Levi.Caption"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/external_mod_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.05"
            android:maxLines="2"
            android:minLines="2"
            android:textAppearance="@style/TextAppearance.Levi.Body"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <!-- Minecraft versions, download type, then the catalog tags (added in code). -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/external_mod_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="4dp">

            <TextView
                android:id="@+id/external_mod_versions"
                style="@style/Widget.Levi.Tag.Accent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="260dp"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/external_mod_download_type"
                style="@style/Widget.Levi.Tag"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingHorizontal="8dp"
                android:textSize="9sp" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/external_mod_action"
            style="@style/Widget.Levi.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="8dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/install"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
