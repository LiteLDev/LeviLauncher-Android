<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/external_mod_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="4dp" android:orientation="vertical" android:padding="10dp" android:background="@drawable/bg_polish_card">
    <View android:id="@+id/external_mod_divider" android:layout_width="match_parent" android:layout_height="0dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <FrameLayout android:id="@+id/external_mod_icon_chip" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_ui_icon_chip">
            <ImageView android:id="@+id/external_mod_icon" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="2dp" android:scaleType="centerCrop" android:importantForAccessibility="no" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/external_mod_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" />
            <TextView android:id="@+id/external_mod_author" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/text_secondary" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/external_mod_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_secondary" android:textSize="12sp" android:maxLines="3" android:ellipsize="end" android:lineSpacingExtra="1dp" />
    <com.google.android.material.chip.ChipGroup android:id="@+id/external_mod_tags" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" app:chipSpacingHorizontal="5dp" app:chipSpacingVertical="4dp">
        <TextView android:id="@+id/external_mod_versions" style="@style/Widget.Levi.Tag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" />
        <TextView android:id="@+id/external_mod_download_type" style="@style/Widget.Levi.Tag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" />
    </com.google.android.material.chip.ChipGroup>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical">
        <TextView android:id="@+id/external_mod_version" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp" android:textColor="@color/text_secondary" android:textSize="11sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/external_mod_action" style="@style/Widget.Levi.Button.Primary" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="88dp" android:text="@string/install" android:textSize="12sp" app:cornerRadius="9dp" />
    </LinearLayout>
</LinearLayout>
