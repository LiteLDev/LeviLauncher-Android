<?xml version="1.0" encoding="utf-8"?>
<!-- A catalog row inside the results card (same pattern as the LeviMC mods list):
     icon chip, name | author · version, description, tags, and the install button at the end. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/external_mod_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/external_mod_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="92dp"
        android:orientation="horizontal"
        android:padding="16dp">

        <FrameLayout
            android:id="@+id/external_mod_icon_chip"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_ui_icon_chip">

            <ImageView
                android:id="@+id/external_mod_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/external_mod_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxWidth="280dp"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Levi.SectionTitle" />

                <TextView
                    android:id="@+id/external_mod_author"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:maxWidth="200dp"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Levi.Caption"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/external_mod_version"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Levi.Caption"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/external_mod_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.05"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Levi.Body"
                android:textColor="@color/text_secondary" />

            <!-- Minecraft versions, download type, then the catalog tags (added in code). -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/external_mod_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="4dp">

                <TextView
                    android:id="@+id/external_mod_versions"
                    style="@style/Widget.Levi.Tag.Accent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxWidth="260dp" />

                <TextView
                    android:id="@+id/external_mod_download_type"
                    style="@style/Widget.Levi.Tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/external_mod_action"
            style="@style/Widget.Levi.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:minWidth="88dp"
            android:text="@string/install" />
    </LinearLayout>
</LinearLayout>
