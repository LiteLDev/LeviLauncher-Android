<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:id="@+id/msft_login_root" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ms_choose_login_method" android:textAppearance="@style/TextAppearance.Levi.SectionTitle" android:textSize="18sp" android:includeFontPadding="false" android:accessibilityHeading="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/accounts_sign_in_subtitle" android:textAppearance="@style/TextAppearance.Levi.Caption" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp">
        <ScrollView android:id="@+id/msft_method_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:overScrollMode="never" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="top" android:paddingBottom="8dp">
                <TextView android:id="@+id/msft_method_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:padding="12dp" android:background="@drawable/bg_ui_card_inner" android:textAppearance="@style/TextAppearance.Levi.Body" android:textColor="@color/ui_danger" android:textSize="12sp" android:accessibilityLiveRegion="polite" android:visibility="gone" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false">
                    <com.google.android.material.card.MaterialCardView style="@style/Widget.Levi.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="5dp" app:cardCornerRadius="12dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_monitor" app:tint="@color/accent_text" android:importantForAccessibility="no" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/accounts_embedded_title" android:textAppearance="@style/TextAppearance.Levi.SectionTitle" android:textSize="15sp" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="36dp" android:text="@string/accounts_embedded_description" android:textAppearance="@style/TextAppearance.Levi.Caption" android:textSize="12sp" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/msft_web_login_button" style="@style/Widget.Levi.Button.Primary" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="12dp" android:text="@string/ms_webview_login" android:textSize="12sp" app:icon="@drawable/ic_ui_person" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView style="@style/Widget.Levi.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="5dp" app:cardCornerRadius="12dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_internet" app:tint="@color/accent_text" android:importantForAccessibility="no" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/accounts_device_title" android:textAppearance="@style/TextAppearance.Levi.SectionTitle" android:textSize="15sp" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="36dp" android:text="@string/accounts_device_description" android:textAppearance="@style/TextAppearance.Levi.Caption" android:textSize="12sp" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/msft_device_login_button" style="@style/Widget.Levi.Button.Secondary" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="12dp" android:text="@string/ms_device_code_login" android:textSize="12sp" app:icon="@drawable/ic_ui_open_in_new" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <ScrollView android:id="@+id/msft_device_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:overScrollMode="never" android:scrollbars="none" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_vertical" android:paddingBottom="8dp">
                <com.google.android.material.card.MaterialCardView style="@style/Widget.Levi.Card" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="16dp" android:baselineAligned="false">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="20dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ms_device_code_label" android:textAppearance="@style/TextAppearance.Levi.Caption" android:textSize="11sp" />
                            <TextView android:id="@+id/msft_device_code" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/ms_device_code_waiting_code" android:fontFamily="monospace" android:textStyle="bold" android:textColor="@color/text_primary" android:textSize="28sp" android:letterSpacing="0.08" android:gravity="center" android:textIsSelectable="true" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" />
                            <TextView android:id="@+id/msft_device_url" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textAppearance="@style/TextAppearance.Levi.Body" android:textColor="@color/accent_text" android:textSize="12sp" android:textIsSelectable="true" />
                            <TextView android:id="@+id/msft_device_expiry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.Levi.Caption" android:textSize="11sp" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/msft_copy_code" style="@style/Widget.Levi.Button.Secondary" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginTop="8dp" android:text="@string/ms_device_code_copy" android:textSize="12sp" android:enabled="false" app:icon="@drawable/ic_ui_code" />
                        </LinearLayout>
                        <View android:layout_width="1dp" android:layout_height="132dp" android:background="@color/divider" android:layout_marginEnd="20dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.15" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ms_device_code_step_title" android:textAppearance="@style/TextAppearance.Levi.SectionTitle" android:textSize="14sp" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/accounts_device_steps" android:textAppearance="@style/TextAppearance.Levi.Caption" android:textSize="12sp" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/msft_open_browser" style="@style/Widget.Levi.Button.Primary" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="10dp" android:text="@string/ms_device_code_open_browser" android:textSize="12sp" android:enabled="false" app:icon="@drawable/ic_ui_open_in_new" />
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="36dp" android:gravity="center_vertical" android:layout_marginTop="4dp">
                                <ProgressBar android:id="@+id/msft_device_progress" android:layout_width="16dp" android:layout_height="16dp" android:indeterminateTint="@color/primary" />
                                <TextView android:id="@+id/msft_device_status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/ms_device_code_requesting" android:textAppearance="@style/TextAppearance.Levi.Caption" android:textSize="11sp" android:accessibilityLiveRegion="polite" />
                            </LinearLayout>
                            <com.google.android.material.button.MaterialButton android:id="@+id/msft_device_cancel" style="@style/Widget.Levi.Button.Ghost" android:layout_width="match_parent" android:layout_height="40dp" android:text="@string/ms_choose_other_method" android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
        <LinearLayout android:id="@+id/msft_web_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/accounts_microsoft_page" android:textAppearance="@style/TextAppearance.Levi.Caption" android:textSize="11sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/msft_web_cancel" style="@style/Widget.Levi.Button.Ghost" android:layout_width="wrap_content" android:layout_height="40dp" android:text="@string/ms_choose_other_method" android:textSize="12sp" />
            </LinearLayout>
            <FrameLayout android:id="@+id/msft_web_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        </LinearLayout>
        <FrameLayout android:id="@+id/msft_progress_overlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:clickable="true" android:focusable="true" android:visibility="gone">
            <com.google.android.material.card.MaterialCardView style="@style/Widget.Levi.Card" android:layout_width="300dp" android:layout_height="wrap_content" android:layout_gravity="center" app:cardCornerRadius="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <ProgressBar android:id="@+id/msft_progress_bar" android:layout_width="24dp" android:layout_height="24dp" android:indeterminateTint="@color/primary" />
                        <TextView android:id="@+id/msft_progress_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="@string/ms_login_fetch_minecraft_identity" android:textAppearance="@style/TextAppearance.Levi.Body" android:textSize="13sp" android:accessibilityLiveRegion="polite" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/msft_progress_cancel" style="@style/Widget.Levi.Button.Ghost" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="10dp" android:text="@android:string/cancel" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
