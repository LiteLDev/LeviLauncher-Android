<?xml version="1.0" encoding="utf-8"?>
<!-- Home page (Windows LauncherPage): header card with the instance selector and the launch button,
     then the Mods / Content management / Content download cards. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/main_card"
        style="@style/Widget.Levi.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/minecraft_title_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/misans"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.025"
                        android:singleLine="true"
                        android:text="@string/minecraft"
                        android:textColor="@color/accent_text"
                        android:textFontWeight="900"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                    <!-- Subtitle and the loader chip share the second line, so the chip stays reachable
                         when the instance cluster leaves little room for the title. -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/misans"
                            android:text="@string/bedrock_edition"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/loader_chip"
                            style="@style/Widget.Levi.Tag.Accent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:minHeight="28dp"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="@string/pkg_loader_name"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progress_loader"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/select_version_button"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_ui_row"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/home_instance_letter"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_ui_icon_chip"
                        android:fontFamily="@font/misans"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:text="M"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/misans"
                            android:text="@string/current_instance"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/text_minecraft_version"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/misans"
                            android:maxWidth="170dp"
                            android:minWidth="72dp"
                            android:singleLine="true"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="12dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ui_expand_more"
                        app:tint="@color/text_primary" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/home_instance_settings_button"
                    style="@style/Widget.Levi.Button.Icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/instance_settings_title"
                    android:tooltipText="@string/instance_settings_title"
                    app:icon="@drawable/ic_nav_settings"
                    app:iconSize="22dp" />

                <!-- Split launch button: the main part launches, the chevron opens more launch options. -->
                <LinearLayout
                    android:id="@+id/home_launch_group"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/home_bg_launch_group"
                    android:elevation="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/launch_button"
                        style="@style/Widget.Levi.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minHeight="48dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="12dp"
                        android:stateListAnimator="@null"
                        android:text="@string/launch"
                        android:textSize="17sp"
                        app:backgroundTint="@android:color/transparent"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_nav_launch"
                        app:iconPadding="8dp"
                        app:iconSize="20dp"
                        app:rippleColor="#33FFFFFF" />

                    <View
                        android:id="@+id/home_launch_divider"
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:alpha="0.4"
                        android:background="@color/on_primary" />

                    <ImageView
                        android:id="@+id/home_launch_menu_button"
                        android:layout_width="40dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_ui_row"
                        android:clickable="true"
                        android:contentDescription="@string/home_launch_options"
                        android:focusable="true"
                        android:paddingStart="8dp"
                        android:paddingEnd="10dp"
                        android:src="@drawable/ic_ui_expand_more"
                        android:tooltipText="@string/home_launch_options"
                        app:tint="@color/on_primary" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ui_lightbulb"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/tip_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/misans"
                    android:singleLine="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Mods: the whole card opens the mods page. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mod_card"
            style="@style/Widget.Levi.Card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp">

                    <FrameLayout
                        android:id="@+id/home_mods_chip"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_ui_icon_chip">

                        <ImageView
                            android:id="@+id/home_mods_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ui_puzzle" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/mods_section_title"
                        android:textAppearance="@style/TextAppearance.Levi.SectionTitle" />

                    <TextView
                        android:id="@+id/manage_mods_button"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_ui_row"
                        android:drawableEnd="@drawable/ic_ui_chevron_right"
                        android:drawablePadding="2dp"
                        android:drawableTint="@color/text_secondary"
                        android:fontFamily="@font/misans"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="4dp"
                        android:text="@string/home_manage"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ScrollView
                        android:id="@+id/home_mods_scroll"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fadingEdgeLength="16dp"
                        android:fillViewport="true"
                        android:requiresFadingEdge="vertical"
                        android:scrollbars="none"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/mods_list_container"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="8dp" />
                    </ScrollView>

                    <LinearLayout
                        android:id="@+id/home_mods_empty"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ui_puzzle"
                            app:tint="@color/ui_muted" />

                        <TextView
                            android:id="@+id/home_mods_empty_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/home_mods_empty"
                            android:textAppearance="@style/TextAppearance.Levi.Body"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Content management -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/content_mgmt_card"
            style="@style/Widget.Levi.Card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp">

                    <FrameLayout
                        android:id="@+id/home_content_chip"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_ui_icon_chip">

                        <ImageView
                            android:id="@+id/home_content_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_content" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/content_mgmt_section_title"
                        android:textAppearance="@style/TextAppearance.Levi.SectionTitle" />

                    <TextView
                        android:id="@+id/content_view_all"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_ui_row"
                        android:drawableEnd="@drawable/ic_ui_chevron_right"
                        android:drawablePadding="2dp"
                        android:drawableTint="@color/text_secondary"
                        android:fontFamily="@font/misans"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="4dp"
                        android:text="@string/home_view_all"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fadingEdgeLength="16dp"
                    android:requiresFadingEdge="vertical"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <LinearLayout
                            android:id="@+id/content_worlds_row"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_ui_row"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingEnd="6dp">

                            <FrameLayout
                                android:id="@+id/home_worlds_chip"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_ui_icon_chip">

                                <ImageView
                                    android:id="@+id/home_worlds_icon"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_ui_globe" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="@string/worlds_category"
                                android:textAppearance="@style/TextAppearance.Levi.Body"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/content_worlds_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/misans"
                                android:text="0"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="6dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_ui_chevron_right"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/content_resource_packs_row"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_ui_row"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingEnd="6dp">

                            <FrameLayout
                                android:id="@+id/home_resource_packs_chip"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_ui_icon_chip">

                                <ImageView
                                    android:id="@+id/home_resource_packs_icon"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_ui_image" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="@string/resource_packs_category"
                                android:textAppearance="@style/TextAppearance.Levi.Body"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/content_resource_packs_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/misans"
                                android:text="0"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="6dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_ui_chevron_right"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/content_behavior_packs_row"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_ui_row"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingEnd="6dp">

                            <FrameLayout
                                android:id="@+id/home_behavior_packs_chip"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_ui_icon_chip">

                                <ImageView
                                    android:id="@+id/home_behavior_packs_icon"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_ui_bolt" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="@string/behavior_packs_category"
                                android:textAppearance="@style/TextAppearance.Levi.Body"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/content_behavior_packs_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/misans"
                                android:text="0"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="6dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_ui_chevron_right"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>

                    </LinearLayout>
                </ScrollView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Content download -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/misc_card"
            style="@style/Widget.Levi.Card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp">

                    <FrameLayout
                        android:id="@+id/home_download_chip"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_ui_icon_chip">

                        <ImageView
                            android:id="@+id/home_download_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ui_cloud_download" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/home_content_download"
                        android:textAppearance="@style/TextAppearance.Levi.SectionTitle" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fadingEdgeLength="16dp"
                    android:requiresFadingEdge="vertical"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <LinearLayout
                            android:id="@+id/misc_curseforge_row"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_ui_row"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingEnd="6dp">

                            <FrameLayout
                                android:id="@+id/home_curseforge_chip"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_ui_icon_chip">

                                <ImageView
                                    android:id="@+id/home_curseforge_icon"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_qa_curseforge" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="@string/curseforge_title"
                                android:textAppearance="@style/TextAppearance.Levi.Body"
                                android:textSize="15sp" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="6dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_ui_chevron_right"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/misc_pkg_row"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_ui_row"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingEnd="6dp">

                            <FrameLayout
                                android:id="@+id/home_pkg_chip"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_ui_icon_chip">

                                <ImageView
                                    android:id="@+id/home_pkg_icon"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_modules" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="@string/pkg_title_mods"
                                android:textAppearance="@style/TextAppearance.Levi.Body"
                                android:textSize="15sp" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="6dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_ui_chevron_right"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/misc_external_mods_row"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_ui_row"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingEnd="6dp">

                            <FrameLayout
                                android:id="@+id/home_external_mods_chip"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_ui_icon_chip">

                                <ImageView
                                    android:id="@+id/home_external_mods_icon"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_plugin" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="@string/external_mods"
                                android:textAppearance="@style/TextAppearance.Levi.Body"
                                android:textSize="15sp" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="6dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_ui_chevron_right"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>

                    </LinearLayout>
                </ScrollView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</LinearLayout>
