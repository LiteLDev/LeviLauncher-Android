<?xml version="1.0" encoding="utf-8"?>
<!-- Installed tab of PackagesActivity (the package part of upstream ModsPage), two-pane: the left card holds the
     title, tabs, install actions, search and filters; the current instance's packages fill the right card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="16dp">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Levi.Card"
        android:layout_width="@dimen/levi_side_panel_width"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <include layout="@layout/catalog_pkg_header_lead" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pkg_inst_btn_id"
                    style="@style/Widget.Levi.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/pkg_installed_install_id"
                    app:icon="@drawable/ic_ui_add"
                    app:iconGravity="textStart" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pkg_inst_btn_file"
                        style="@style/Widget.Levi.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/pkg_installed_install_file"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/pkg_installed_install_file"
                        app:icon="@drawable/ic_ui_upload"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pkg_inst_btn_refresh"
                        style="@style/Widget.Levi.Button.Icon"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/pkg_refresh"
                        app:icon="@drawable/ic_ui_refresh" />
                </LinearLayout>

                <EditText
                    android:id="@+id/pkg_inst_search"
                    style="@style/Widget.Levi.Input"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:drawableStart="@drawable/ic_ui_search"
                    android:hint="@string/pkg_installed_search_hint"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text" />

                <LinearLayout
                    android:id="@+id/pkg_inst_filters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <!-- All / Installed by you / Dependencies (stacked: InstalledFragment sets it vertical) -->
                    <org.levimc.launcher.ui.widget.SegmentedControl
                        android:id="@+id/pkg_inst_filter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/pkg_inst_only_enabled"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/misans"
                        android:paddingStart="2dp"
                        android:switchPadding="8dp"
                        android:text="@string/pkg_installed_only_enabled"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/pkg_inst_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:paddingStart="2dp"
                        android:textAppearance="@style/TextAppearance.Levi.Caption" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Levi.Card"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/levi_pane_gap"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/pkg_inst_selection_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/ui_strip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/pkg_inst_selected_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:maxWidth="140dp"
                    android:textAppearance="@style/TextAppearance.Levi.Body"
                    android:textStyle="bold" />

                <!-- The right pane is narrower than the old full-width card: the actions scroll if they do not fit. -->
                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end|center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/pkg_inst_select_all"
                            style="@style/Widget.Levi.Button.Ghost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pkg_installed_select_all" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/pkg_inst_update_selected"
                            style="@style/Widget.Levi.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/pkg_installed_update_selected" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/pkg_inst_uninstall_selected"
                            style="@style/Widget.Levi.Button.Danger"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/pkg_installed_uninstall_selected" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/pkg_inst_selection_done"
                            style="@style/Widget.Levi.Button.Primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/pkg_installed_selection_done" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <TextView
                android:id="@+id/pkg_inst_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingTop="10dp"
                android:paddingEnd="18dp"
                android:fontFamily="@font/misans"
                android:textColor="@color/ui_warning"
                android:textSize="12sp"
                android:visibility="gone" />

            <org.levimc.launcher.ui.packages.TaskProgressView
                android:id="@+id/pkg_inst_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="12dp"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/pkg_inst_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp"
                    android:scrollbars="none" />

                <LinearLayout
                    android:id="@+id/pkg_inst_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/pkg_inst_empty_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="6"
                        android:maxWidth="480dp"
                        android:textAppearance="@style/TextAppearance.Levi.Body"
                        android:textColor="@color/text_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pkg_inst_empty_action"
                        style="@style/Widget.Levi.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/pkg_retry"
                        android:visibility="gone" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pkg_inst_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
