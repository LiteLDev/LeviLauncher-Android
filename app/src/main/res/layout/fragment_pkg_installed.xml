<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/pkg_inst_page" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingTop="6dp" android:focusable="true" android:focusableInTouchMode="true">
    <include layout="@layout/view_pkg_catalog_header" />
    <com.google.android.material.card.MaterialCardView style="@style/Widget.Levi.Card" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginBottom="8dp" android:layout_weight="1" android:layout_marginTop="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
            <TextView android:id="@+id/pkg_inst_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:textAppearance="@style/TextAppearance.Levi.Caption" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="2dp" android:textSize="11sp" android:maxLines="1" />
            <LinearLayout android:id="@+id/pkg_inst_selection_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/ui_strip" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="8dp" android:paddingEnd="12dp" android:paddingBottom="8dp" android:visibility="gone">
                <TextView android:id="@+id/pkg_inst_selected_count" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAppearance="@style/TextAppearance.Levi.Body" android:textStyle="bold" android:textSize="12sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/pkg_inst_select_all" style="@style/Widget.Levi.Button.Ghost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pkg_installed_select_all" android:minHeight="36dp" android:textSize="12sp" android:paddingStart="10dp" android:paddingEnd="10dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/pkg_inst_update_selected" style="@style/Widget.Levi.Button.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/pkg_installed_update_selected" android:minHeight="36dp" android:textSize="12sp" android:paddingStart="10dp" android:paddingEnd="10dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/pkg_inst_uninstall_selected" style="@style/Widget.Levi.Button.Danger" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/pkg_installed_uninstall_selected" android:minHeight="36dp" android:textSize="12sp" android:paddingStart="10dp" android:paddingEnd="10dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/pkg_inst_selection_done" style="@style/Widget.Levi.Button.Primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/pkg_installed_selection_done" android:minHeight="36dp" android:textSize="12sp" android:paddingStart="10dp" android:paddingEnd="10dp" />
            </LinearLayout>
            <TextView android:id="@+id/pkg_inst_notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="18dp" android:paddingTop="10dp" android:paddingEnd="18dp" android:fontFamily="@font/misans" android:textColor="@color/ui_warning" android:textSize="11sp" android:visibility="gone" />
            <org.levimc.launcher.ui.packages.TaskProgressView android:id="@+id/pkg_inst_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginTop="8dp" android:layout_marginEnd="12dp" android:visibility="gone" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/pkg_inst_list" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingStart="12dp" android:paddingTop="8dp" android:paddingEnd="12dp" android:paddingBottom="8dp" android:scrollbars="none" android:nestedScrollingEnabled="false" android:overScrollMode="never" />
                <ScrollView android:id="@+id/pkg_inst_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:fillViewport="true" android:nestedScrollingEnabled="false" android:overScrollMode="never" android:scrollbars="none">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="16dp">
                        <TextView android:id="@+id/pkg_inst_empty_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:maxWidth="520dp" android:textAppearance="@style/TextAppearance.Levi.Body" android:textColor="@color/text_secondary" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/pkg_inst_empty_action" style="@style/Widget.Levi.Button.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/pkg_retry" android:visibility="gone" />
                    </LinearLayout>
                </ScrollView>
                <ProgressBar android:id="@+id/pkg_inst_loading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
