<?xml version="1.0" encoding="utf-8"?>
<!-- Installed tab of PackagesActivity (the package part of upstream ModsPage): header card (title, tabs, search,
     install actions, filters), then the current instance's packages in a card. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Levi.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            app:layout_scrollFlags="scroll|enterAlways">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <include layout="@layout/catalog_pkg_header_lead" />

                    <EditText
                        android:id="@+id/pkg_inst_search"
                        style="@style/Widget.Levi.Input"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_ui_search"
                        android:hint="@string/pkg_installed_search_hint"
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no"
                        android:inputType="text" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pkg_inst_btn_refresh"
                        style="@style/Widget.Levi.Button.Icon"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/pkg_refresh"
                        app:icon="@drawable/ic_ui_refresh" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pkg_inst_btn_file"
                        style="@style/Widget.Levi.Button.Icon"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/pkg_installed_install_file"
                        app:icon="@drawable/ic_ui_upload" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pkg_inst_btn_id"
                        style="@style/Widget.Levi.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:text="@string/pkg_installed_install_id"
                        app:icon="@drawable/ic_ui_add" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pkg_inst_filters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- All / Installed by you / Dependencies -->
                    <org.levimc.launcher.ui.widget.SegmentedControl
                        android:id="@+id/pkg_inst_filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/pkg_inst_only_enabled"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="16dp"
                        android:fontFamily="@font/misans"
                        android:switchPadding="8dp"
                        android:text="@string/pkg_installed_only_enabled"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/pkg_inst_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="2"
                        android:textAppearance="@style/TextAppearance.Levi.Caption" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </com.google.android.material.appbar.AppBarLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Levi.Card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/pkg_inst_selection_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/ui_strip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/pkg_inst_selected_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Levi.Body"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pkg_inst_select_all"
                    style="@style/Widget.Levi.Button.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pkg_installed_select_all" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pkg_inst_update_selected"
                    style="@style/Widget.Levi.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/pkg_installed_update_selected" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pkg_inst_uninstall_selected"
                    style="@style/Widget.Levi.Button.Danger"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/pkg_installed_uninstall_selected" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pkg_inst_selection_done"
                    style="@style/Widget.Levi.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/pkg_installed_selection_done" />
            </LinearLayout>

            <TextView
                android:id="@+id/pkg_inst_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingTop="10dp"
                android:paddingEnd="18dp"
                android:fontFamily="@font/misans"
                android:textColor="@color/ui_warning"
                android:textSize="12sp"
                android:visibility="gone" />

            <org.levimc.launcher.ui.packages.TaskProgressView
                android:id="@+id/pkg_inst_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="12dp"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/pkg_inst_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp"
                    android:scrollbars="none" />

                <LinearLayout
                    android:id="@+id/pkg_inst_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/pkg_inst_empty_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:maxWidth="520dp"
                        android:textAppearance="@style/TextAppearance.Levi.Body"
                        android:textColor="@color/text_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pkg_inst_empty_action"
                        style="@style/Widget.Levi.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/pkg_retry"
                        android:visibility="gone" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pkg_inst_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
