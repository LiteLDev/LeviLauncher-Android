<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:focusable="true" android:focusableInTouchMode="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="40dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Body" android:text="@string/mods_section_title" android:textSize="18sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/mods_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Caption" android:textSize="11sp" android:singleLine="true" android:ellipsize="end" android:layout_marginTop="2dp" android:includeFontPadding="false" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/mods_get_button" style="@style/Widget.Levi.Button.Secondary" android:layout_width="wrap_content" android:layout_height="36dp" android:minWidth="0dp" android:minHeight="36dp" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/mods_get_mods" app:icon="@drawable/ic_ui_cloud_download" app:iconSize="16dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/add_mod_fullscreen_button" style="@style/Widget.Levi.Button.Primary" android:layout_width="wrap_content" android:layout_height="36dp" android:minWidth="0dp" android:minHeight="36dp" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginStart="6dp" android:text="@string/add_mod" app:icon="@drawable/ic_ui_add" app:iconSize="16dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/mods_refresh_button" style="@style/Widget.Levi.Button.Icon" android:layout_width="36dp" android:layout_height="36dp" android:minWidth="36dp" android:minHeight="36dp" android:textSize="12sp" android:paddingStart="0dp" android:paddingEnd="0dp" android:layout_marginStart="6dp" android:contentDescription="@string/mods_refresh" app:icon="@drawable/ic_ui_refresh" app:iconSize="18dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
        <EditText android:id="@+id/mods_search" style="@style/Widget.Levi.Input" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:minHeight="36dp" android:drawableStart="@drawable/ic_ui_search" android:hint="@string/mods_search_hint" android:imeOptions="actionSearch|flagNoExtractUi" android:importantForAutofill="no" android:inputType="text" />
        <com.google.android.material.button.MaterialButton android:id="@+id/mods_filters_button" style="@style/Widget.Levi.Button.Secondary" android:layout_width="wrap_content" android:layout_height="36dp" android:minWidth="0dp" android:minHeight="36dp" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginStart="8dp" android:text="@string/mods_filters" app:icon="@drawable/ic_ui_filter" app:iconSize="16dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/mods_sort_button" style="@style/Widget.Levi.Button.Icon" android:layout_width="36dp" android:layout_height="36dp" android:minWidth="36dp" android:minHeight="36dp" android:textSize="12sp" android:paddingStart="0dp" android:paddingEnd="0dp" android:layout_marginStart="6dp" android:contentDescription="@string/mods_sort" app:icon="@drawable/ic_ui_sort" app:iconSize="18dp" />
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView style="@style/Widget.Levi.Card" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="40dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:fillViewport="true" android:overScrollMode="never" android:scrollbars="none">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <org.levimc.launcher.ui.widget.SegmentedControl android:id="@+id/mods_filter_tabs" android:layout_width="wrap_content" android:layout_height="32dp" />
                    <TextView android:id="@+id/mods_count" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minWidth="40dp" android:layout_marginStart="8dp" android:layout_marginEnd="10dp" android:gravity="end" android:singleLine="true" android:textAppearance="@style/TextAppearance.Levi.Caption" android:textSize="11sp" />
                </LinearLayout>
            </HorizontalScrollView>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
            <ProgressBar android:id="@+id/mods_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="2dp" android:indeterminate="true" android:indeterminateTint="@color/primary" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/mods_recycler_fullscreen" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="4dp" android:scrollbars="none" android:overScrollMode="ifContentScrolls" />
                <ScrollView android:id="@+id/mods_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:overScrollMode="never" android:scrollbars="none" android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Body" android:id="@+id/mods_empty_title" android:text="@string/mods_loading" android:textSize="15sp" android:textStyle="bold" android:gravity="center" android:includeFontPadding="false" />
                        <TextView android:id="@+id/mods_empty_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Caption" android:gravity="center" android:textSize="12sp" android:layout_marginTop="6dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/mods_empty_action" style="@style/Widget.Levi.Button.Primary" android:layout_width="wrap_content" android:layout_height="36dp" android:minWidth="0dp" android:minHeight="36dp" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginTop="12dp" android:text="@string/mods_clear_filters" app:icon="@drawable/ic_close" app:iconSize="16dp" />
                    </LinearLayout>
                </ScrollView>
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
