<?xml version="1.0" encoding="utf-8"?>
<!-- Package manager card of SettingsActivity (third-party components tab), driven by SettingsCard.
     Ordered like LeviLauncher's (Windows) components tab: package manager + clean cache, then the
     mirror switch, then the GitHub proxy; Android-only package rows sit with the package manager. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pkg_settings_card"
    style="@style/settings_Card">

    <LinearLayout style="@style/settings_CardBody">

        <!-- Package manager + clean cache -->
        <LinearLayout style="@style/settings_Row">

            <LinearLayout style="@style/settings_RowText">

                <TextView
                    style="@style/settings_RowTitle"
                    android:text="@string/pkg_settings_title" />

                <TextView
                    style="@style/settings_RowDesc"
                    android:text="@string/pkg_settings_desc" />

                <TextView
                    android:id="@+id/pkg_settings_cache_size"
                    style="@style/settings_RowDesc"
                    android:text="@string/pkg_settings_cache_size_computing" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pkg_settings_cache_clean"
                style="@style/Widget.Levi.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pkg_settings_cache_clean" />
        </LinearLayout>

        <org.levimc.launcher.ui.packages.TaskProgressView
            android:id="@+id/pkg_settings_cache_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <View style="@style/settings_Divider" />

        <!-- Catalogue -->
        <LinearLayout style="@style/settings_Row">

            <LinearLayout style="@style/settings_RowText">

                <TextView
                    style="@style/settings_RowTitle"
                    android:text="@string/pkg_settings_catalog_title" />

                <TextView
                    android:id="@+id/pkg_settings_catalog_age"
                    style="@style/settings_RowDesc"
                    android:text="@string/pkg_checking" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pkg_settings_catalog_refresh"
                style="@style/Widget.Levi.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pkg_settings_catalog_refresh" />
        </LinearLayout>

        <View style="@style/settings_Divider" />

        <!-- Package scripts -->
        <LinearLayout style="@style/settings_Row">

            <LinearLayout style="@style/settings_RowText">

                <TextView
                    style="@style/settings_RowTitle"
                    android:text="@string/pkg_settings_scripts_title" />

                <TextView
                    style="@style/settings_RowDesc"
                    android:text="@string/pkg_settings_scripts_desc" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/pkg_settings_scripts_switch"
                style="@style/settings_Switch" />
        </LinearLayout>

        <View style="@style/settings_Divider" />

        <!-- Mirror -->
        <LinearLayout style="@style/settings_Row">

            <LinearLayout style="@style/settings_RowText">

                <TextView
                    style="@style/settings_RowTitle"
                    android:text="@string/pkg_settings_mirror_title" />

                <TextView
                    style="@style/settings_RowDesc"
                    android:text="@string/pkg_settings_mirror_desc" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <Spinner
                    android:id="@+id/pkg_settings_mirror_spinner"
                    style="@style/Widget.Levi.Input"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minWidth="140dp"
                    android:paddingEnd="36dp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ui_expand_more"
                    app:tint="@color/text_secondary" />
            </FrameLayout>
        </LinearLayout>

        <View style="@style/settings_Divider" />

        <!-- GitHub proxy: title and description on the left, preset picker on the right (as on Windows) -->
        <LinearLayout
            style="@style/settings_Row"
            android:paddingBottom="4dp">

            <LinearLayout style="@style/settings_RowText">

                <TextView
                    style="@style/settings_RowTitle"
                    android:text="@string/pkg_settings_proxy_title" />

                <TextView
                    style="@style/settings_RowDesc"
                    android:text="@string/pkg_settings_proxy_desc" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <Spinner
                    android:id="@+id/pkg_settings_proxy_preset"
                    style="@style/Widget.Levi.Input"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minWidth="180dp"
                    android:paddingEnd="36dp"
                    android:contentDescription="@string/pkg_settings_proxy_title" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ui_expand_more"
                    app:tint="@color/text_secondary" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/pkg_settings_proxy_input"
                style="@style/Widget.Levi.Input"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="@string/pkg_settings_proxy_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textUri" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pkg_settings_proxy_reset"
                style="@style/Widget.Levi.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/reset" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pkg_settings_proxy_save"
                style="@style/Widget.Levi.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/save" />
        </LinearLayout>

        <TextView
            android:id="@+id/pkg_settings_proxy_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.Levi.Caption"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/pkg_settings_proxy_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/misans"
            android:textColor="@color/error"
            android:textSize="12sp"
            android:visibility="gone" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
