<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/news_card"
    style="@style/Widget.Levi.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="10dp"
    app:rippleColor="@color/ui_default">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/news_item_unread"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_news_unread_dot" />

            <TextView
                android:id="@+id/news_item_important"
                style="@style/Widget.Levi.Tag"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/v161_misc_news_important"
                android:gravity="center"
                android:paddingStart="9dp"
                android:paddingTop="0dp"
                android:paddingEnd="9dp"
                android:paddingBottom="0dp"
                android:textSize="9sp"
                android:text="@string/news_important"
                android:textColor="@color/ui_danger"
                android:visibility="gone" />

            <TextView
                android:id="@+id/news_item_category"
                style="@style/Widget.Levi.Tag"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:background="@drawable/v161_misc_news_tag"
                android:gravity="center"
                android:paddingStart="9dp"
                android:paddingTop="0dp"
                android:paddingEnd="9dp"
                android:paddingBottom="0dp"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/news_item_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:gravity="end"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Levi.Caption"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/news_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/misans"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/news_item_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:lineSpacingMultiplier="1.08"
            android:textAppearance="@style/TextAppearance.Levi.PageSubtitle" />

        <TextView
            android:id="@+id/news_item_action"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_ui_row"
            android:drawablePadding="5dp"
            android:fontFamily="@font/misans"
            android:gravity="center_vertical"
            android:text="@string/news_read_more"
            android:textColor="@color/accent_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
