<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/news_card" style="@style/Widget.Levi.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" app:cardCornerRadius="10dp" app:rippleColor="@color/ui_default">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <View android:id="@+id/news_item_unread" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_news_unread_dot" />
            <TextView android:id="@+id/news_item_category" style="@style/Widget.Levi.Tag.Accent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" />
            <TextView android:id="@+id/news_item_important" style="@style/Widget.Levi.Tag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/news_important" android:textColor="@color/ui_danger" android:textSize="10sp" android:background="@drawable/bg_news_important" android:visibility="gone" />
            <TextView android:id="@+id/news_item_date" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:gravity="end" android:textAppearance="@style/TextAppearance.Levi.Caption" android:textSize="11sp" />
        </LinearLayout>
        <TextView android:id="@+id/news_item_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textAppearance="@style/TextAppearance.Levi.SectionTitle" android:textSize="16sp" />
        <TextView android:id="@+id/news_item_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textAppearance="@style/TextAppearance.Levi.Body" android:textColor="@color/text_secondary" android:textSize="12sp" android:lineSpacingExtra="2dp" />
        <TextView android:id="@+id/news_item_action" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginTop="4dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:background="?attr/selectableItemBackground" android:drawablePadding="6dp" android:text="@string/news_read_more" android:textAppearance="@style/TextAppearance.Levi.Body" android:textColor="@color/accent_text" android:textStyle="bold" android:textSize="12sp" android:gravity="center_vertical" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
