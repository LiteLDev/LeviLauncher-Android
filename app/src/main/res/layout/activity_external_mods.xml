<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:paddingStart="16dp" android:paddingTop="10dp" android:paddingEnd="16dp" android:paddingBottom="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/external_mods" android:textAppearance="@style/TextAppearance.Levi.PageTitle" android:textSize="20sp" />
            <TextView android:id="@+id/external_mods_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textAppearance="@style/TextAppearance.Levi.PageSubtitle" android:textSize="12sp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/external_mods_discord" style="@style/Widget.Levi.Button.Secondary" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="10dp" android:text="@string/mods_external_join" android:textSize="12sp" app:icon="@drawable/ic_discord" app:iconSize="18dp" app:iconPadding="6dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/external_mods_refresh" style="@style/Widget.Levi.Button.Icon" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:contentDescription="@string/external_mods_refresh" app:icon="@drawable/ic_ui_refresh" />
    </LinearLayout>
    <org.levimc.launcher.ui.widget.CatalogToolbarLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
        <EditText android:id="@+id/external_mods_search" style="@style/Widget.Levi.Input" android:layout_width="match_parent" android:layout_height="44dp" android:drawableStart="@drawable/ic_ui_search" android:hint="@string/external_mods_search_hint" android:inputType="text" android:singleLine="true" android:imeOptions="actionSearch" android:importantForAutofill="no" android:textSize="13sp" />
        <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/external_mods_compatible_filter" android:layout_width="wrap_content" android:layout_height="44dp" android:minHeight="44dp" android:buttonTint="@color/primary" android:text="@string/mods_external_compatible" android:textColor="@color/text_primary" android:textSize="12sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/external_mods_sort" style="@style/Widget.Levi.Button.Secondary" android:layout_width="wrap_content" android:layout_height="44dp" android:textSize="12sp" app:icon="@drawable/ic_ui_sort" app:iconSize="18dp" app:iconPadding="6dp" />
    </org.levimc.launcher.ui.widget.CatalogToolbarLayout>
    <TextView android:id="@+id/external_mods_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="8dp" android:background="@drawable/bg_polish_notice" android:textColor="@color/ui_warning" android:textSize="12sp" android:visibility="gone" />
    <TextView android:id="@+id/external_mods_results" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="6dp" android:textColor="@color/text_secondary" android:textSize="11sp" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/external_mods_recycler" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="4dp" android:overScrollMode="never" />
        <ProgressBar android:id="@+id/external_mods_progress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:indeterminateTint="@color/primary" />
        <LinearLayout android:id="@+id/external_mods_empty_layout" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:visibility="gone">
            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_ui_search" android:importantForAccessibility="no" app:tint="@color/text_secondary" />
            <TextView android:id="@+id/external_mods_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/external_mods_empty" android:textColor="@color/text_primary" android:textSize="14sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/external_mods_clear" style="@style/Widget.Levi.Button.Secondary" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginTop="10dp" android:text="@string/mods_clear_filters" android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
