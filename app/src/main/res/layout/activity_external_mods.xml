<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Levi.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="0dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/external_mods"
                        android:textAppearance="@style/TextAppearance.Levi.PageTitle"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/external_mods_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="@style/TextAppearance.Levi.PageSubtitle"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/external_mods_discord"
                    style="@style/Widget.Levi.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="11dp"
                    android:text="@string/mods_external_join"
                    android:textSize="11sp"
                    app:cornerRadius="9dp"
                    app:icon="@drawable/ic_discord"
                    app:iconPadding="6dp"
                    app:iconSize="17dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/external_mods_refresh"
                    style="@style/Widget.Levi.Button.Icon"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="38dp"
                    android:minHeight="38dp"
                    android:contentDescription="@string/external_mods_refresh"
                    app:icon="@drawable/ic_ui_refresh" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/external_mods_search"
                style="@style/Widget.Levi.Input"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_ui_search"
                android:hint="@string/external_mods_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:textSize="12sp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/external_mods_compatible_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="38dp"
                android:text="@string/mods_external_compatible"
                android:textAppearance="@style/TextAppearance.Levi.Body"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/external_mods_sort"
                style="@style/Widget.Levi.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:minHeight="0dp"
                android:minWidth="130dp"
                android:paddingHorizontal="12dp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_ui_sort" />
        </LinearLayout>

        <TextView
            android:id="@+id/external_mods_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.Levi.Caption"
            android:textSize="11sp"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Levi.Card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minHeight="160dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/external_mods_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp" />

                <ProgressBar
                    android:id="@+id/external_mods_progress"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/primary" />

                <TextView
                    android:id="@+id/external_mods_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:drawableTop="@drawable/ic_ui_puzzle"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/ui_muted"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="@string/external_mods_empty"
                    android:textAppearance="@style/TextAppearance.Levi.Body"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
</LinearLayout>
