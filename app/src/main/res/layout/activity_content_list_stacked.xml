<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <!-- Header card (scrolls away with the list so the list keeps room on short landscape screens). -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/header_card"
            style="@style/Widget.Levi.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:layout_scrollFlags="scroll|enterAlways|snap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/normal_toolbar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="40dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/title_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/content_ui_worlds_title"
                            android:textAppearance="@style/TextAppearance.Levi.PageTitle" />

                        <TextView
                            android:id="@+id/item_count_text"
                            style="@style/Widget.Levi.Tag"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="8dp"
                            android:gravity="center"
                            android:minWidth="34dp"
                            android:paddingStart="8dp"
                            android:paddingTop="0dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="0dp"
                            android:text="0"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="normal" />

                        <!-- v1.6.1 single row: title, count, search (+ sort), Select, Custom Flat World, refresh.
                             The Space only takes the free width when search_row is gone (screenshots). -->
                        <LinearLayout
                            android:id="@+id/search_row"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/search_edit_text"
                                style="@style/Widget.Levi.Input"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_weight="1"
                                android:drawableStart="@drawable/ic_ui_filter"
                                android:minHeight="0dp"
                                android:hint="@string/search_hint"
                                android:imeOptions="actionSearch"
                                android:importantForAutofill="no"
                                android:inputType="text" />

                            <Space
                                android:id="@+id/search_spacer"
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="0" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/sort_button"
                                style="@style/Widget.Levi.Button.Secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:layout_marginStart="8dp"
                                android:minHeight="0dp"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:text="@string/content_ui_sort_name"
                                android:textSize="12sp"
                                app:icon="@drawable/ic_ui_sort" />
                        </LinearLayout>

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="0.001" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/select_button"
                            style="@style/Widget.Levi.Button.Icon"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@string/content_ui_multi_select"
                            android:tooltipText="@string/content_ui_multi_select"
                            android:visibility="gone"
                            app:icon="@drawable/ic_ui_select" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/custom_flat_button"
                            style="@style/Widget.Levi.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:minHeight="0dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:textSize="12sp"
                            android:layout_marginStart="8dp"
                            android:text="@string/custom_flat_world"
                            android:visibility="gone"
                            app:icon="@drawable/ic_ui_add" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/refresh_button"
                            style="@style/Widget.Levi.Button.Icon"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@string/content_ui_refresh"
                            android:tooltipText="@string/content_ui_refresh"
                            app:icon="@drawable/ic_ui_refresh" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/selection_toolbar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="40dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/selection_cancel_button"
                            style="@style/Widget.Levi.Button.Icon"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:contentDescription="@string/cancel"
                            android:tooltipText="@string/cancel"
                            app:icon="@drawable/ic_ui_arrow_back" />

                        <TextView
                            android:id="@+id/selection_count_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/selected_count_zero"
                            android:textAppearance="@style/TextAppearance.Levi.SectionTitle"
                            android:textSize="16sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/select_all_button"
                            style="@style/Widget.Levi.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:minHeight="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textSize="12sp"
                            android:text="@string/select_all"
                            app:icon="@drawable/ic_ui_select" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/batch_export_button"
                            style="@style/Widget.Levi.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_height="38dp"
                            android:minHeight="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textSize="12sp"
                            android:text="@string/export"
                            app:icon="@drawable/ic_ui_download" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/batch_transfer_button"
                            style="@style/Widget.Levi.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_height="38dp"
                            android:minHeight="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textSize="12sp"
                            android:text="@string/transfer"
                            app:icon="@drawable/ic_ui_storage" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/batch_delete_button"
                            style="@style/Widget.Levi.Button.Danger"
                            android:layout_width="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_height="38dp"
                            android:minHeight="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textSize="12sp"
                            android:text="@string/delete"
                            app:icon="@drawable/ic_ui_delete" />
                    </LinearLayout>
                </FrameLayout>


                <HorizontalScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_ui_strip"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="40dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/current_instance"
                            android:textAppearance="@style/TextAppearance.Levi.StripLabel" />

                        <TextView
                            android:id="@+id/strip_instance_value"
                            style="@style/Widget.Levi.StripValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="14dp"
                            android:layout_marginHorizontal="10dp"
                            android:background="@color/ui_border" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/content_ui_storage"
                            android:textAppearance="@style/TextAppearance.Levi.StripLabel" />

                        <TextView
                            android:id="@+id/strip_storage_value"
                            style="@style/Widget.Levi.StripValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/content_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="8dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/empty_state_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:alpha="0.5"
                android:contentDescription="@null"
                android:src="@drawable/ic_world"
                app:tint="@color/ui_muted" />

            <TextView
                android:id="@+id/empty_state_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/misans"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/empty_state_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Levi.Caption" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/loading_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/loading_progress"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:indeterminate="true" />
        </FrameLayout>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
