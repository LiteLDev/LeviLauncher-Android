<?xml version="1.0" encoding="utf-8"?>
<!-- Body of the package developer guide (BrowseFragment.DevGuideDialog, a CustomAlertDialog custom view). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misans"
            android:lineSpacingExtra="3dp"
            android:text="@string/pkg_guide_description"
            android:textColor="@color/on_surface"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/misans"
            android:lineSpacingExtra="3dp"
            android:text="@string/pkg_guide_manifest_hint"
            android:textColor="@color/on_surface"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/misans"
            android:lineSpacingExtra="3dp"
            android:text="@string/pkg_guide_variant_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/misans"
            android:lineSpacingExtra="3dp"
            android:text="@string/pkg_guide_android_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
