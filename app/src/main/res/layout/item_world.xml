<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/world_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/content_bg_item_card"
    android:gravity="center_vertical"
    android:minHeight="88dp"
    android:orientation="horizontal"
    android:padding="12dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/world_icon"
        android:layout_width="112dp"
        android:layout_height="64dp"
        android:background="@drawable/content_bg_thumb"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_world"
        app:shapeAppearanceOverlay="@style/LeviContentThumbnailShape" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/world_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/misans"
            android:maxLines="1"
            android:text="@string/world_name_placeholder"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_ui_storage"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/world_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/world_game_mode_survival_placeholder"
                android:textAppearance="@style/TextAppearance.Levi.Caption" />

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_ui_schedule"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/world_last_played"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/world_last_played_placeholder"
                android:textAppearance="@style/TextAppearance.Levi.Caption" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/world_edit_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/content_bg_icon_button"
        android:contentDescription="@string/edit"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_edit"
        android:tooltipText="@string/edit"
        app:tint="@color/text_primary" />

    <ImageButton
        android:id="@+id/world_overflow_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/content_bg_icon_button"
        android:contentDescription="@string/more_actions"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_ui_more"
        android:tooltipText="@string/more_actions"
        app:tint="@color/text_primary" />

    <ImageView
        android:id="@+id/world_selection_indicator"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/content_bg_icon_button"
        android:contentDescription="@string/selected"
        android:padding="9dp"
        android:src="@drawable/ic_check"
        android:visibility="gone"
        app:tint="@color/accent_text" />
</LinearLayout>
