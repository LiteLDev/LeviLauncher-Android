<?xml version="1.0" encoding="utf-8"?>
<org.levimc.launcher.ui.dialogs.LauncherDialogLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_shell" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:id="@+id/dialog_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/dialog_header_icon" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginEnd="10dp" android:padding="9dp" android:importantForAccessibility="no" android:visibility="gone" />
        <TextView android:id="@+id/tv_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="17sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:accessibilityHeading="true" />
    </LinearLayout>
    <FrameLayout android:id="@+id/dialog_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginTop="12dp" android:layout_marginBottom="14dp">
        <ScrollView android:id="@+id/message_scroll_view" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="false" android:overScrollMode="never">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/tv_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13.5sp" android:includeFontPadding="false" android:lineSpacingExtra="2dp" />
                <LinearLayout android:id="@+id/custom_view_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/items_recycler_view" android:layout_width="match_parent" android:layout_height="wrap_content" android:clipToPadding="false" android:overScrollMode="never" android:visibility="gone" />
    </FrameLayout>
    <View android:id="@+id/dialog_action_divider" android:layout_width="match_parent" android:layout_height="1dp" />
    <LinearLayout android:id="@+id/btn_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="end|center_vertical">
        <Button android:id="@+id/btn_negative" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_neutral" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_positive" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
</org.levimc.launcher.ui.dialogs.LauncherDialogLayout>
