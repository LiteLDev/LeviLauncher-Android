<?xml version="1.0" encoding="utf-8"?>
<!-- PackagesActivity: "LeviMC Mods" with the Browse and Installed tabs and the target instance chip. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misans"
            android:text="@string/pkg_title_mods"
            android:textColor="@color/primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pkg_tab_browse"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_tab_selected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/misans"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="@string/pkg_tab_browse"
                android:textColor="@color/on_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/pkg_tab_installed"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tab_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/misans"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="@string/pkg_tab_installed"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pkg_target_chip"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_cf_search"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_minecraft_cube" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/misans"
                android:text="@string/pkg_target_label"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/pkg_target_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:fontFamily="@font/misans"
                android:maxWidth="220dp"
                android:maxLines="1"
                android:textColor="@color/on_surface"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_down"
                app:tint="@color/on_surface" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/pkg_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1" />
</LinearLayout>
