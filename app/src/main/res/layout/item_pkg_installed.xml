<?xml version="1.0" encoding="utf-8"?>
<!-- An installed package package of the Installed tab (InstalledFragment.Adapter). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pkg_inst_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_cf_item"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="11dp"
    android:paddingVertical="10dp">

    <CheckBox
        android:id="@+id/pkg_inst_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/pkg_inst_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_cf_icon"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_minecraft_cube" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pkg_inst_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/misans"
                android:maxLines="1"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="LHolo" />

            <TextView
                android:id="@+id/pkg_inst_kind"
                style="@style/PkgChip"
                android:layout_marginStart="6dp"
                android:textStyle="bold"
                tools:text="Dependency" />

            <TextView
                android:id="@+id/pkg_inst_local"
                style="@style/PkgChip"
                android:layout_marginStart="4dp"
                android:text="@string/pkg_installed_local"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/pkg_inst_identity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="middle"
            android:fontFamily="@font/misans"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="github.com/LiteLDev/LHolo#client · v1.0.0" />

        <TextView
            android:id="@+id/pkg_inst_includes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/misans"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="Includes: LHolo" />

        <TextView
            android:id="@+id/pkg_inst_not_loadable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/misans"
            android:text="@string/pkg_installed_not_loadable"
            android:textColor="@color/pkg_log_warning"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pkg_inst_required_by"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/misans"
            android:maxLines="2"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="Required by: Foo" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end|center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pkg_inst_update"
            style="@style/PkgChip"
            android:textStyle="bold"
            tools:text="Update to 1.1.0" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/pkg_inst_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/pkg_inst_more"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="6dp"
        android:src="@drawable/ic_more_vert"
        app:tint="@color/text_secondary" />
</LinearLayout>
