<?xml version='1.0' encoding='utf-8'?>
<org.levimc.launcher.ui.dialogs.LauncherDialogLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/tv_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/version_name" android:textColor="?attr/colorPrimary" android:textSize="17sp" android:textStyle="bold" android:fontFamily="@font/misans" />
    <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginTop="12dp" android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <EditText android:id="@+id/edit_version_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:padding="12dp" android:textColor="?attr/colorOnSurface" android:textSize="13.5sp" android:singleLine="true" android:inputType="text" android:background="@drawable/bg_edit_text" android:hint="@string/version_name" android:textColorHint="?attr/colorOnSurfaceVariant" />
            <TextView android:id="@+id/text_version_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/name_invalid" android:textColor="#FF5252" android:textSize="12sp" android:visibility="gone" android:layout_marginTop="4dp" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end" android:layout_marginTop="12dp">
        <Button android:id="@+id/btn_cancel" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cancel" android:textColor="?attr/colorOnSurfaceVariant" />
        <Button android:id="@+id/btn_install" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/install" android:enabled="false" android:layout_marginStart="12dp" android:backgroundTint="?attr/colorPrimary" android:textColor="?attr/colorOnPrimary" />
    </LinearLayout>
</org.levimc.launcher.ui.dialogs.LauncherDialogLayout>