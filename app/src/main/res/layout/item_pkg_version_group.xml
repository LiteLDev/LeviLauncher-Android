<?xml version="1.0" encoding="utf-8"?>
<!-- A group header of the Versions tab (PackageActivity.VersionAdapter): game version, LeviLamina ranges, count. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_cf_search"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pkg_group_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misans"
            android:textColor="@color/on_surface"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Minecraft 1.26.60.05" />

        <TextView
            android:id="@+id/pkg_group_ranges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/misans"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="LeviLamina 26.60.*" />
    </LinearLayout>

    <TextView
        android:id="@+id/pkg_group_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/misans"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        tools:text="3 versions" />

    <ImageView
        android:id="@+id/pkg_group_chevron"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_arrow_down"
        app:tint="@color/text_secondary" />
</LinearLayout>
