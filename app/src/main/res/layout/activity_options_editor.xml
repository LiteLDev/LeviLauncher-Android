<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="10dp" android:paddingEnd="16dp" android:paddingBottom="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/title_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/edit_options" android:textAppearance="@style/TextAppearance.Levi.PageTitle" android:textSize="20sp" />
            <TextView android:id="@+id/options_editor_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/options_editor_subtitle" android:textSize="12sp" android:textColor="@color/text_secondary" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/save_button" style="@style/Widget.Levi.Button.Primary" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="12dp" android:text="@string/save" android:textSize="12sp" app:icon="@drawable/ic_save" app:iconSize="17dp" app:iconPadding="6dp" />
    </LinearLayout>
    <org.levimc.launcher.ui.widget.CatalogToolbarLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
        <EditText android:id="@+id/search_edit_text" style="@style/Widget.Levi.Input" android:layout_width="match_parent" android:layout_height="44dp" android:drawableStart="@drawable/ic_ui_search" android:hint="@string/search_options_hint" android:inputType="text" android:singleLine="true" android:imeOptions="actionSearch" android:importantForAutofill="no" android:textSize="13sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/options_category_button" style="@style/Widget.Levi.Button.Secondary" android:layout_width="wrap_content" android:layout_height="44dp" android:text="@string/options_category_all" android:textSize="12sp" app:icon="@drawable/ic_ui_filter" app:iconSize="17dp" app:iconPadding="6dp" />
    </org.levimc.launcher.ui.widget.CatalogToolbarLayout>
    <TextView android:id="@+id/options_editor_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" android:textSize="11sp" android:textColor="@color/text_secondary" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/options_recycler_view" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:overScrollMode="never" android:descendantFocusability="afterDescendants" android:paddingBottom="4dp" />
        <ProgressBar android:id="@+id/loading_progress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:visibility="gone" />
        <TextView android:id="@+id/empty_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:padding="20dp" android:text="@string/no_options_found" android:textColor="@color/text_secondary" android:textSize="14sp" android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
