<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/mod_detail_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="40dp">
        <TextView android:id="@+id/mod_detail_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAppearance="@style/TextAppearance.Levi.Body" android:text="@string/mod_detail_title" android:textSize="18sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Body" android:id="@+id/mod_status_text" android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" />
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/mod_switch_detail" style="@style/Widget.Levi.Switch" android:layout_width="52dp" android:layout_height="36dp" android:minHeight="0dp" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:fillViewport="true" android:scrollbars="none" android:overScrollMode="ifContentScrolls">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <com.google.android.material.card.MaterialCardView style="@style/Widget.Levi.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/mod_detail_header_container">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <FrameLayout android:id="@+id/mod_icon_container" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="12dp" android:visibility="gone">
                            <ImageView android:id="@+id/mod_icon_detail" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/mod_name_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Body" android:textSize="16sp" android:textStyle="bold" android:includeFontPadding="false" android:textIsSelectable="true" />
                            <TextView android:id="@+id/mod_author_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Caption" android:textSize="12sp" android:layout_marginTop="5dp" android:textIsSelectable="true" android:lineSpacingExtra="1dp" android:includeFontPadding="false" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:id="@+id/mod_pkg_chip" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Caption" android:textSize="11sp" android:textColor="@color/accent_text" android:textIsSelectable="true" android:layout_marginTop="8dp" android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.Levi.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/mod_detail_info_container" android:layout_marginTop="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Body" android:id="@+id/mod_description_heading" android:textSize="13sp" android:textStyle="bold" android:text="@string/mod_detail_about" />
                    <TextView android:id="@+id/mod_description_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Body" android:textSize="12sp" android:textIsSelectable="true" android:lineSpacingExtra="2dp" android:layout_marginTop="6dp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" />
                    <include android:id="@+id/mod_version_row" layout="@layout/item_mod_detail_meta_row" />
                    <include android:id="@+id/mod_minecraft_versions_row" layout="@layout/item_mod_detail_meta_row" />
                    <include android:id="@+id/mod_config_files_row" layout="@layout/item_mod_detail_meta_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.Levi.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/mod_detail_actions_container" android:layout_marginTop="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <com.google.android.material.button.MaterialButton android:id="@+id/configure_mod_button" style="@style/Widget.Levi.Button.Primary" android:layout_width="wrap_content" android:layout_height="36dp" android:minHeight="36dp" android:text="@string/configure" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:visibility="gone" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/delete_mod_button" style="@style/Widget.Levi.Button.Danger" android:layout_width="wrap_content" android:layout_height="36dp" android:minHeight="36dp" android:text="@string/delete_mod" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginStart="6dp" />
                    </LinearLayout>
                    <HorizontalScrollView android:id="@+id/mod_pkg_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:scrollbars="none" android:overScrollMode="ifContentScrolls" android:visibility="gone">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <com.google.android.material.button.MaterialButton android:id="@+id/pkg_update_button" style="@style/Widget.Levi.Button.Primary" android:layout_width="wrap_content" android:layout_height="36dp" android:minHeight="36dp" android:text="@string/pkg_menu_update" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:visibility="gone" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/pkg_promote_button" style="@style/Widget.Levi.Button.Secondary" android:layout_width="wrap_content" android:layout_height="36dp" android:minHeight="36dp" android:text="@string/pkg_action_promote" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:visibility="gone" android:layout_marginStart="6dp" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/pkg_open_package_button" style="@style/Widget.Levi.Button.Secondary" android:layout_width="wrap_content" android:layout_height="36dp" android:minHeight="36dp" android:text="@string/pkg_menu_open_package" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:visibility="gone" android:layout_marginStart="6dp" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
