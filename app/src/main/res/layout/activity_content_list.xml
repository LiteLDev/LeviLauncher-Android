<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:focusable="true" android:focusableInTouchMode="true">
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/header_card">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/normal_toolbar">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="40dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Body" android:textSize="18sp" android:includeFontPadding="false" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:id="@+id/title_text" android:text="@string/content_ui_worlds_title" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Caption" android:textSize="12sp" android:includeFontPadding="false" android:layout_marginStart="8dp" android:text="0" android:singleLine="true" android:id="@+id/item_count_text" />
                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <com.google.android.material.button.MaterialButton android:layout_width="wrap_content" android:layout_height="36dp" android:id="@+id/select_button" style="@style/Widget.Levi.Button.Secondary" android:minHeight="36dp" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:visibility="gone" android:layout_marginStart="8dp" android:text="@string/content_ui_select" app:icon="@drawable/ic_check" />
                <com.google.android.material.button.MaterialButton android:layout_width="wrap_content" android:layout_height="36dp" android:id="@+id/custom_flat_button" style="@style/Widget.Levi.Button.Primary" android:minHeight="36dp" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:visibility="gone" android:layout_marginStart="6dp" android:text="@string/custom_flat_world" app:icon="@drawable/ic_ui_add" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/search_row" android:layout_marginTop="6dp">
                <EditText android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:id="@+id/search_edit_text" style="@style/Widget.Levi.Input" android:minHeight="36dp" android:textSize="12sp" android:drawableStart="@drawable/ic_ui_search" android:hint="@string/search_hint" android:imeOptions="actionSearch|flagNoExtractUi" android:inputType="text" android:importantForAutofill="no" />
                <com.google.android.material.button.MaterialButton android:layout_width="wrap_content" android:layout_height="36dp" android:id="@+id/sort_button" style="@style/Widget.Levi.Button.Secondary" android:minHeight="36dp" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginStart="8dp" app:iconSize="16dp" android:text="@string/content_ui_sort_name" app:icon="@drawable/ic_ui_sort" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/selection_toolbar" android:minHeight="40dp" android:visibility="gone">
            <com.google.android.material.button.MaterialButton android:layout_width="wrap_content" android:layout_height="36dp" android:id="@+id/selection_cancel_button" style="@style/Widget.Levi.Button.Icon" android:minHeight="36dp" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:contentDescription="@string/cancel" android:tooltipText="@string/cancel" app:icon="@drawable/ic_close" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Body" android:textSize="13sp" android:includeFontPadding="false" android:layout_marginStart="8dp" android:singleLine="true" android:ellipsize="end" android:id="@+id/selection_count_text" android:text="@string/selected_count_zero" android:maxWidth="144dp" />
            <HorizontalScrollView android:layout_width="0dp" android:layout_height="40dp" android:fillViewport="false" android:scrollbars="none" android:overScrollMode="ifContentScrolls" android:layout_weight="1" android:layout_marginStart="8dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <com.google.android.material.button.MaterialButton android:layout_width="wrap_content" android:layout_height="36dp" android:id="@+id/select_all_button" style="@style/Widget.Levi.Button.Secondary" android:minHeight="36dp" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/select_all" app:icon="@drawable/ic_check" />
                    <com.google.android.material.button.MaterialButton android:layout_width="wrap_content" android:layout_height="36dp" android:id="@+id/batch_export_button" style="@style/Widget.Levi.Button.Secondary" android:minHeight="36dp" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginStart="6dp" android:text="@string/export" app:icon="@drawable/ic_ui_download" />
                    <com.google.android.material.button.MaterialButton android:layout_width="wrap_content" android:layout_height="36dp" android:id="@+id/batch_transfer_button" style="@style/Widget.Levi.Button.Secondary" android:minHeight="36dp" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginStart="6dp" android:text="@string/transfer" app:icon="@drawable/ic_ui_storage" />
                    <com.google.android.material.button.MaterialButton android:layout_width="wrap_content" android:layout_height="36dp" android:id="@+id/batch_delete_button" style="@style/Widget.Levi.Button.Danger" android:minHeight="36dp" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginStart="6dp" android:text="@string/delete" app:icon="@drawable/ic_ui_delete" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp" android:minHeight="32dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Caption" android:textSize="11sp" android:includeFontPadding="false" android:layout_weight="1" android:singleLine="true" android:ellipsize="end" android:layout_marginEnd="12dp" android:id="@+id/strip_instance_value" />
        <com.google.android.material.button.MaterialButton android:layout_width="wrap_content" android:layout_height="30dp" android:id="@+id/strip_storage_value" style="@style/Widget.Levi.Button.Secondary" android:minHeight="30dp" android:textSize="11sp" android:paddingStart="12dp" android:paddingEnd="12dp" app:iconSize="13dp" android:maxWidth="300dp" android:singleLine="true" android:ellipsize="end" android:contentDescription="@string/content_ui_storage_location" app:icon="@drawable/ic_ui_storage" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp">
        <androidx.recyclerview.widget.RecyclerView android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/content_recycler_view" android:clipToPadding="false" android:paddingBottom="4dp" android:nestedScrollingEnabled="false" android:overScrollMode="ifContentScrolls" android:scrollbars="none" />
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/empty_state" android:visibility="gone" android:fillViewport="true" android:nestedScrollingEnabled="false" android:overScrollMode="ifContentScrolls" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="16dp">
                <ImageView android:layout_width="36dp" android:layout_height="36dp" android:id="@+id/empty_state_icon" android:alpha="0.5" android:src="@drawable/ic_world" android:importantForAccessibility="no" app:tint="@color/text_secondary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Body" android:textSize="14sp" android:includeFontPadding="false" android:textStyle="bold" android:gravity="center" android:layout_marginTop="8dp" android:id="@+id/empty_state_title" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Levi.Caption" android:textSize="12sp" android:includeFontPadding="false" android:gravity="center" android:layout_marginTop="5dp" android:maxWidth="480dp" android:id="@+id/empty_state_message" />
                <com.google.android.material.button.MaterialButton android:layout_width="wrap_content" android:layout_height="36dp" android:id="@+id/empty_state_action" style="@style/Widget.Levi.Button.Secondary" android:minHeight="36dp" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginTop="10dp" android:visibility="gone" android:text="@string/content_ui_clear_search" />
            </LinearLayout>
        </ScrollView>
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/loading_overlay" android:clickable="true" android:focusable="false" android:visibility="gone">
            <ProgressBar android:layout_width="32dp" android:layout_height="32dp" android:id="@+id/loading_progress" android:layout_gravity="center" android:indeterminate="true" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
