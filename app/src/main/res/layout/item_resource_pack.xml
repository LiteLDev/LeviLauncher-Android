<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/pack_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="0dp" android:layout_marginVertical="4dp" android:background="@drawable/bg_content_item" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp" android:paddingVertical="10dp" android:minHeight="76dp" android:foreground="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
    <com.google.android.material.imageview.ShapeableImageView android:id="@+id/pack_icon" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/content_bg_thumb" android:contentDescription="@null" android:scaleType="centerCrop" android:src="@drawable/ic_photo" app:shapeAppearanceOverlay="@style/LeviContentThumbnailShape" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
        <TextView android:id="@+id/pack_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="@font/misans" android:maxLines="2" android:text="@string/resource_pack_name_placeholder" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" android:includeFontPadding="false" />
        <TextView android:id="@+id/pack_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:ellipsize="end" android:maxLines="1" android:textAppearance="@style/TextAppearance.Levi.Caption" android:textSize="11sp" android:includeFontPadding="false" />
        <TextView android:id="@+id/pack_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:ellipsize="end" android:maxLines="2" android:text="@string/resource_pack_description_placeholder" android:textAppearance="@style/TextAppearance.Levi.Body" android:textColor="@color/text_secondary" android:textSize="11sp" android:includeFontPadding="false" />
    </LinearLayout>
    <ImageButton android:id="@+id/pack_export_button" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/content_bg_icon_button" android:contentDescription="@string/export" android:padding="8dp" android:scaleType="fitCenter" android:src="@drawable/ic_ui_download" android:tooltipText="@string/export" app:tint="@color/text_primary" android:layout_marginStart="4dp" />
    <ImageButton android:id="@+id/pack_overflow_button" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/content_bg_icon_button" android:contentDescription="@string/more_actions" android:padding="8dp" android:scaleType="fitCenter" android:src="@drawable/ic_ui_more" android:tooltipText="@string/more_actions" app:tint="@color/text_primary" android:layout_marginStart="4dp" />
    <ImageView android:id="@+id/pack_selection_indicator" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/content_bg_icon_button" android:contentDescription="@string/selected" android:padding="7dp" android:src="@drawable/ic_check" android:visibility="gone" app:tint="@color/accent_text" />
</LinearLayout>
