<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pack_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/content_bg_item_card"
    android:gravity="center_vertical"
    android:minHeight="80dp"
    android:orientation="horizontal"
    android:padding="12dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/pack_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/content_bg_thumb"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_photo"
        app:shapeAppearanceOverlay="@style/LeviContentThumbnailShape" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pack_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/misans"
            android:maxLines="1"
            android:text="@string/resource_pack_name_placeholder"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pack_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/resource_pack_description_placeholder"
            android:textAppearance="@style/TextAppearance.Levi.Body"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/pack_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Levi.Caption" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/pack_export_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/content_bg_icon_button"
        android:contentDescription="@string/export"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_ui_download"
        android:tooltipText="@string/export"
        app:tint="@color/text_primary" />

    <ImageButton
        android:id="@+id/pack_overflow_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/content_bg_icon_button"
        android:contentDescription="@string/more_actions"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_ui_more"
        android:tooltipText="@string/more_actions"
        app:tint="@color/text_primary" />

    <ImageView
        android:id="@+id/pack_selection_indicator"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/content_bg_icon_button"
        android:contentDescription="@string/selected"
        android:padding="9dp"
        android:src="@drawable/ic_check"
        android:visibility="gone"
        app:tint="@color/accent_text" />
</LinearLayout>
