<?xml version="1.0" encoding="utf-8"?>
<!-- Browse tab of PackagesActivity (Windows LIP page), two-pane: the left card holds the title, tabs, search, the
     four selects and the actions; the catalogue fills the right card (pagination is the list's footer item). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="16dp">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Levi.Card"
        android:layout_width="@dimen/levi_side_panel_width"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <include layout="@layout/catalog_pkg_header_lead" />

                <EditText
                    android:id="@+id/pkg_search_box"
                    style="@style/Widget.Levi.Input"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:drawableStart="@drawable/ic_ui_search"
                    android:hint="@string/pkg_search_hint"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pkg_btn_search"
                    style="@style/Widget.Levi.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/pkg_search"
                    app:icon="@drawable/ic_ui_search"
                    app:iconGravity="textStart" />

                <TextView
                    style="@style/CatalogFieldLabel"
                    android:layout_marginTop="14dp"
                    android:text="@string/pkg_game_version_label" />

                <TextView
                    android:id="@+id/pkg_spinner_game"
                    style="@style/CatalogSelect"
                    android:layout_width="match_parent" />

                <TextView
                    style="@style/CatalogFieldLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/pkg_ll_version_label" />

                <TextView
                    android:id="@+id/pkg_spinner_ll"
                    style="@style/CatalogSelect"
                    android:layout_width="match_parent" />

                <TextView
                    style="@style/CatalogFieldLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/pkg_sort_by" />

                <!-- Relevance / Stars / Updated / Newest (levimc.org's sorts) -->
                <TextView
                    android:id="@+id/pkg_spinner_sort"
                    style="@style/CatalogSelect"
                    android:layout_width="match_parent" />

                <TextView
                    style="@style/CatalogFieldLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/catalog_order" />

                <TextView
                    android:id="@+id/pkg_spinner_order"
                    style="@style/CatalogSelect"
                    android:layout_width="match_parent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Tags, License, Dependencies and Author (BrowseFragment.FiltersSheet) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pkg_btn_filters"
                        style="@style/Widget.Levi.Button.Icon"
                        android:contentDescription="@string/pkg_filters"
                        app:icon="@drawable/ic_ui_filter" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pkg_btn_refresh"
                        style="@style/Widget.Levi.Button.Icon"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/pkg_refresh"
                        app:icon="@drawable/ic_ui_refresh" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pkg_btn_guide"
                        style="@style/Widget.Levi.Button.Icon"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/pkg_guide_open"
                        app:icon="@drawable/ic_ui_code" />
                </LinearLayout>

                <!-- The facet filters in effect, each removable (tap); wraps to more lines in the narrow panel. -->
                <FrameLayout
                    android:id="@+id/pkg_active_filters_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:visibility="gone">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/pkg_active_filters"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="6dp"
                        app:chipSpacingVertical="4dp"
                        app:singleLine="false" />
                </FrameLayout>

                <TextView
                    android:id="@+id/pkg_mapping_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/misans"
                    android:text="@string/pkg_mapping_unavailable_hint"
                    android:textColor="@color/ui_warning"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/pkg_stale_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/misans"
                    android:textColor="@color/ui_warning"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Levi.Card"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/levi_pane_gap"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/pkg_results"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:scrollbars="none" />

            <LinearLayout
                android:id="@+id/pkg_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/pkg_empty_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="6"
                    android:maxWidth="480dp"
                    android:textAppearance="@style/TextAppearance.Levi.Body"
                    android:textColor="@color/text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pkg_empty_action"
                    style="@style/Widget.Levi.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pkg_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
