    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView android:id="@+id/hud_editor_tools" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginTop="8dp" android:visibility="gone" app:cardCornerRadius="10dp" app:cardElevation="8dp">
        <LinearLayout android:layout_width="300dp" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical">
                <LinearLayout android:id="@+id/hud_editor_drag_handle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="6dp" android:contentDescription="@string/hud_editor_drag_description" android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_drag_handle" android:importantForAccessibility="no" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:text="@string/mod_menu_hud_editor" android:textSize="12sp" />
                </LinearLayout>
                <ImageButton android:id="@+id/btn_hud_reset" android:layout_width="38dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_modmenu_reset" android:contentDescription="@string/reset" />
                <ImageButton android:id="@+id/btn_hud_save" android:layout_width="38dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_modmenu_check" android:contentDescription="@string/save" />
                <ImageButton android:id="@+id/btn_hud_cancel" android:layout_width="38dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_modmenu_close" android:contentDescription="@string/cancel" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/text_hud_button_size" android:layout_width="78dp" android:layout_height="wrap_content" android:text="@string/overlay_button_size" android:textSize="11sp" />
                <SeekBar android:id="@+id/seekbar_hud_button_size" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:min="20" android:max="100" android:progress="56" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</org.levimc.launcher.core.mods.inbuilt.overlay.ModMenuKeyRoot>
