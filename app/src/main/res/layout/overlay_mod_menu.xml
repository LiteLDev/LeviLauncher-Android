                        <TextView android:id="@+id/compact_module_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="6dp" android:textSize="9sp" android:includeFontPadding="false" />
                    </LinearLayout>
                    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                        <FrameLayout android:id="@+id/modules_container" android:layout_width="match_parent" android:layout_height="match_parent">
                            <androidx.recyclerview.widget.RecyclerView android:id="@+id/mods_grid_recycler" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:scrollbars="vertical" android:overScrollMode="never" />
                            <LinearLayout android:id="@+id/empty_state" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="16dp" android:visibility="gone">
                                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_modmenu_search" android:importantForAccessibility="no" />
                                <TextView android:id="@+id/empty_state_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:textSize="12sp" android:gravity="center" android:text="@string/mod_menu_no_mods" />
                                <TextView android:id="@+id/menu_clear_filters" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginTop="9dp" android:gravity="center" android:text="@string/mm_reset_filters" android:textSize="11sp" />
