                            <ImageButton android:id="@+id/nav_modules_compact" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginBottom="4dp" android:padding="9dp" android:visibility="gone" android:src="@drawable/ic_modmenu_layers" android:contentDescription="@string/mod_menu_modules" />
