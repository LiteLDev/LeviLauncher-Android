            <ImageButton android:id="@+id/menu_resize_handle" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="bottom|end" android:padding="5dp" android:src="@drawable/ic_modmenu_resize" android:contentDescription="@string/mm_resize_menu" />
