                            <ImageButton android:id="@+id/nav_hud_editor_compact" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginBottom="4dp" android:padding="9dp" android:visibility="gone" android:src="@drawable/ic_modmenu_edit" android:contentDescription="@string/mod_menu_hud_editor" />
                            <TextView android:id="@+id/nav_settings" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginBottom="3dp" android:gravity="center_vertical" android:text="@string/mm_customize" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:paddingStart="8dp" android:paddingEnd="6dp" android:includeFontPadding="false" android:drawablePadding="8dp" android:drawableStart="@drawable/ic_modmenu_settings" android:clickable="true" android:focusable="true" />
                            <ImageButton android:id="@+id/nav_settings_compact" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginBottom="4dp" android:padding="9dp" android:visibility="gone" android:src="@drawable/ic_modmenu_settings" android:contentDescription="@string/mm_customize" />
