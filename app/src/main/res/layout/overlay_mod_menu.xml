                        <EditText android:id="@+id/search_input" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@null" android:hint="@string/mod_menu_search_hint" android:singleLine="true" android:imeOptions="actionDone" android:inputType="text" android:paddingStart="5dp" android:paddingEnd="2dp" android:textSize="11sp" android:includeFontPadding="false" />
