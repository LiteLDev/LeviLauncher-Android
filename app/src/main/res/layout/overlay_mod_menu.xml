<?xml version="1.0" encoding="utf-8"?>
<org.levimc.launcher.core.mods.inbuilt.overlay.ModMenuKeyRoot xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="true" android:focusable="true">
    <androidx.cardview.widget.CardView android:id="@+id/mod_menu_container" android:layout_width="match_parent" android:layout_height="match_parent" app:cardBackgroundColor="@android:color/transparent" app:cardCornerRadius="14dp" app:cardElevation="12dp" app:cardPreventCornerOverlap="false">
        <org.levimc.launcher.core.mods.inbuilt.overlay.ModMenuSurface android:id="@+id/mod_menu_surface" android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
                <LinearLayout android:id="@+id/mod_menu_sidebar" android:layout_width="152dp" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
                    <LinearLayout android:id="@+id/menu_brand" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
                        <ImageView android:id="@+id/mod_menu_logo" android:layout_width="27dp" android:layout_height="27dp" android:src="@drawable/ic_leaf_logo_mono" android:contentDescription="@string/mm_move_menu" android:padding="4dp" />
                        <LinearLayout android:id="@+id/menu_brand_labels" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="7dp" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="11.5sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
