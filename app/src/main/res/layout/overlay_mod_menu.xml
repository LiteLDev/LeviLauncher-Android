                            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal">
                                <TextView android:id="@+id/filter_all" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginEnd="3dp" android:paddingStart="9dp" android:paddingEnd="9dp" android:gravity="center" android:text="@string/filter_all" android:textSize="11sp" android:clickable="true" android:focusable="true" android:includeFontPadding="false" />
                                <TextView android:id="@+id/filter_favorites" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginEnd="3dp" android:paddingStart="9dp" android:paddingEnd="9dp" android:gravity="center" android:text="@string/mod_menu_favorites" android:textSize="11sp" android:clickable="true" android:focusable="true" android:includeFontPadding="false" />
                                <TextView android:id="@+id/filter_enabled" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginEnd="3dp" android:paddingStart="9dp" android:paddingEnd="9dp" android:gravity="center" android:text="@string/mod_menu_filter_enabled" android:textSize="11sp" android:clickable="true" android:focusable="true" android:includeFontPadding="false" />
                                <TextView android:id="@+id/filter_inbuilt" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginEnd="3dp" android:paddingStart="9dp" android:paddingEnd="9dp" android:gravity="center" android:text="@string/mod_menu_filter_inbuilt" android:textSize="11sp" android:clickable="true" android:focusable="true" android:includeFontPadding="false" />
                                <TextView android:id="@+id/filter_external" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginEnd="3dp" android:paddingStart="9dp" android:paddingEnd="9dp" android:gravity="center" android:text="@string/mod_menu_filter_external" android:textSize="11sp" android:clickable="true" android:focusable="true" android:includeFontPadding="false" />
