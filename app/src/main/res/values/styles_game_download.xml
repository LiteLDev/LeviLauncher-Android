<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Type / status tag of a version row; GameDownloadActivity re-colors it per value. -->
    <style name="GameDownloadChip" parent="Widget.Levi.Tag">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- Column header of the version table (Windows table header). -->
    <style name="GameDownloadColumn" parent="">
        <item name="android:fontFamily">@font/misans</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
