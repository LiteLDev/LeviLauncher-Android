<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Levi.AboutAction" parent="Widget.Levi.Button.Secondary">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconSize">16dp</item>
        <item name="iconPadding">6dp</item>
    </style>
    <style name="Widget.Levi.AboutLink" parent="Widget.Levi.AboutAction">
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="TextAppearance.Levi.AboutTitle" parent="TextAppearance.Levi.SectionTitle">
        <item name="android:textSize">13sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.Levi.AboutCaption" parent="TextAppearance.Levi.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
