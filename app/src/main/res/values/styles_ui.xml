<?xml version="1.0" encoding="utf-8"?>
<!-- Shared launcher UI styles, aligned with LeviLauncher for Windows (HeroUI + launcher overrides).
     Touch sizes: buttons at least 40dp tall, icon buttons 40dp, segmented tabs 40dp. -->
<resources>

    <!-- Cards -->
    <style name="Widget.Levi.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/ui_card_stroke</item>
        <item name="strokeWidth">0dp</item>
        <item name="contentPadding">0dp</item>
    </style>

    <style name="Widget.Levi.Card.Inner">
        <item name="cardCornerRadius">12dp</item>
        <item name="strokeColor">@color/ui_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Text -->
    <style name="TextAppearance.Levi.PageTitle" parent="">
        <item name="android:fontFamily">@font/misans</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/accent_text</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Levi.PageSubtitle" parent="">
        <item name="android:fontFamily">@font/misans</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Levi.SectionTitle" parent="">
        <item name="android:fontFamily">@font/misans</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Levi.Body" parent="">
        <item name="android:fontFamily">@font/misans</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Levi.Caption" parent="">
        <item name="android:fontFamily">@font/misans</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Uppercase-free small label above a select (Windows label). -->
    <style name="TextAppearance.Levi.FieldLabel" parent="">
        <item name="android:fontFamily">@font/misans</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Buttons (Windows: every button is a pill; primary = brand fill, secondary = default fill). -->
    <style name="Widget.Levi.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:fontFamily">@font/misans</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="iconPadding">6dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconGravity">textStart</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Levi.Button.Primary">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="iconTint">@color/on_primary</item>
    </style>

    <style name="Widget.Levi.Button.Secondary">
        <item name="backgroundTint">@color/ui_default</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="rippleColor">#1F808080</item>
    </style>

    <style name="Widget.Levi.Button.Outline">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/accent_text</item>
        <item name="iconTint">@color/accent_text</item>
    </style>

    <style name="Widget.Levi.Button.Danger">
        <item name="backgroundTint">@color/ui_danger_soft</item>
        <item name="android:textColor">@color/ui_danger</item>
        <item name="iconTint">@color/ui_danger</item>
    </style>

    <style name="Widget.Levi.Button.Ghost">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="rippleColor">#1F808080</item>
    </style>

    <!-- Square icon-only button, 40dp (Windows small icon button, enlarged for touch). -->
    <style name="Widget.Levi.Button.Icon" parent="Widget.Levi.Button.Secondary">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconGravity">textStart</item>
        <item name="android:text">@null</item>
    </style>

    <!-- Inputs -->
    <style name="Widget.Levi.Input" parent="">
        <item name="android:background">@drawable/bg_ui_input</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:fontFamily">@font/misans</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">@color/text_secondary</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Tags -->
    <style name="Widget.Levi.Tag" parent="">
        <item name="android:background">@drawable/bg_ui_tag</item>
        <item name="android:fontFamily">@font/misans</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Widget.Levi.Tag.Accent">
        <item name="android:background">@drawable/bg_ui_tag_accent</item>
        <item name="android:textColor">@color/accent_text</item>
    </style>

    <!-- Info strip pieces -->
    <style name="TextAppearance.Levi.StripLabel" parent="">
        <item name="android:fontFamily">@font/misans</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.Levi.StripValue" parent="Widget.Levi.Tag">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Switch -->
    <style name="Widget.Levi.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Navigation: 48x48 icon-only rail item (Windows Sidebar item). -->
    <style name="Widget.Levi.RailItem" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">13dp</item>
        <item name="android:drawablePadding">0dp</item>
        <item name="android:drawableTint">@color/ui_muted</item>
        <item name="android:textSize">0sp</item>
        <item name="android:background">@drawable/bg_shell_icon_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Navigation: icon + label tab of the top navigation bar (Windows GlobalNavbar item). -->
    <style name="Widget.Levi.NavbarItem" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:paddingStart">@dimen/levi_navbar_item_padding</item>
        <item name="android:paddingEnd">@dimen/levi_navbar_item_padding</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableTint">@color/text_primary</item>
        <item name="android:fontFamily">@font/misans</item>
        <item name="android:textSize">@dimen/levi_navbar_text_size</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
