<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ThemeOverlay.Levi.LauncherDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="materialAlertDialogTitleTextStyle">@style/Widget.Levi.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.Levi.DialogBody</item>
        <item name="textAppearanceListItem">@style/TextAppearance.Levi.DialogBody</item>
        <item name="textAppearanceListItemSmall">@style/TextAppearance.Levi.DialogBody</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
    <style name="Widget.Levi.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.Levi.DialogBody" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
