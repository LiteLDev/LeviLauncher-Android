<?xml version="1.0" encoding="utf-8"?>
<!-- Page area next to the sidebar: concave 20dp corner where the top bar meets the rail (Windows
     NavigationFrame). The right and bottom edges are pushed off screen so only the inner edge shows. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetRight="-2dp"
    android:insetBottom="-2dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/background" />
        <corners android:topLeftRadius="20dp" />
        <stroke android:width="1dp" android:color="@color/ui_border" />
    </shape>
</inset>
