<?xml version="1.0" encoding="utf-8"?>
<!-- Content list item card; activated = selected in multi-select mode. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/primary_container" />
            <stroke android:width="1.5dp" android:color="@color/primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/ui_card_stroke" />
        </shape>
    </item>
</selector>
