    <string name="pkg_err_cause_dns">Không thể phân giải tên máy chủ. Hãy kiểm tra kết nối Internet, cài đặt DNS hoặc proxy.</string>
    <string name="pkg_err_cause_tls">Không thể thiết lập kết nối bảo mật. Hãy kiểm tra ngày giờ của thiết bị có đúng không và không có proxy hay VPN nào đang chặn kết nối.</string>
