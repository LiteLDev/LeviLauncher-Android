    <string name="pkg_err_cause_connection">Kết nối tới máy chủ bị từ chối hoặc bị ngắt. Hãy kiểm tra cài đặt mạng, VPN và proxy rồi thử lại.</string>
    <string name="pkg_err_cause_http_403">Máy chủ đã từ chối yêu cầu (HTTP 403). Dịch vụ có thể chặn khu vực mạng của bạn; hãy thử bật bản sao (mirror) hoặc proxy GitHub trong cài đặt Trình quản lý gói.</string>
    <string name="pkg_err_cause_http_404">Không tìm thấy tệp trên máy chủ (HTTP 404). Tệp có thể đã bị xóa hoặc đổi tên; hãy làm mới danh sách rồi thử lại.</string>
    <string name="pkg_err_cause_http_429">Máy chủ đang giới hạn số lượng yêu cầu (HTTP 429). Hãy chờ vài phút rồi thử lại.</string>
    <string name="pkg_err_cause_http_5xx">Máy chủ báo lỗi nội bộ. Đây là sự cố phía máy chủ; hãy thử lại sau.</string>
    <string name="pkg_err_cause_conflict">Không thể cài đặt các gói cùng nhau vì yêu cầu phiên bản của chúng xung đột. Hãy gỡ bỏ hoặc cập nhật mod xung đột rồi thử lại.</string>
    <string name="pkg_err_cause_corrupt">Tệp đã tải xuống bị hỏng hoặc không đầy đủ. Hãy dọn bộ nhớ đệm gói trong cài đặt Trình quản lý gói rồi thử lại.</string>

